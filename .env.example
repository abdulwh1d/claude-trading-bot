# Copy this file to .env and fill it in. Never commit .env or share it.

# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=your-anthropic-key

# app.alpaca.markets -> switch to your PAPER account -> API keys
ALPACA_API_KEY=your-paper-key
ALPACA_SECRET_KEY=your-paper-secret

# Optional: turns on SEC filings in the overnight research. The SEC requires
# a name and email in the User-Agent header.
# SEC_USER_AGENT=Your Name your.email@example.com
