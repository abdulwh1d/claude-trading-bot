//@version=6
indicator("ICT Confluence Dashboard", shorttitle = "ICT Dash", overlay = true, max_boxes_count = 300, max_lines_count = 300, max_labels_count = 300, max_bars_back = 1000)

// ============================================================================
// ICT Confluence Dashboard
// Break of structure, the 79% retracement, fair value gaps and inverse FVGs,
// order flow respected or disrespected, intrabar delta (judged by z-score, share
// of volume and the CVD trend), a SuperFlow-style flow score, big prints,
// relative volume and session timing, for 5-30 minute futures charts (NQ/MNQ,
// ES/MES, GC/MGC). Signals print on candle close only, so they don't repaint.
// Nine more playbooks run alongside: breakout, pullback, range, mean reversion,
// news, spread, scalping, order flow and GEX + order flow, each with its own
// signals, stop, target and record. A side table shows the best long and short
// among them. GEX levels (dealer gamma, from gex/gex_levels.py) are drawn when
// pasted into the settings.
// An engineering tool, not financial advice. History stats ignore fees and
// slippage.
// ============================================================================

// ------------------------------------------------------------------ inputs --
G_S = "Structure"
swingLen     = input.int(5, "Swing length (bars on each side)", minval = 2, maxval = 20, group = G_S, display = display.none)
breakOnClose = input.bool(true, "A break needs a candle close beyond the swing", group = G_S, display = display.none)
showBos      = input.bool(true, "Show BOS / CHoCH", group = G_S, display = display.none)

G_F = "Fibonacci"
fibLevel   = input.float(0.79, "Entry retracement", minval = 0.5, maxval = 0.95, step = 0.01, group = G_F, display = display.none)
fibTolAtr  = input.float(0.10, "Touch tolerance (x ATR)", minval = 0.0, step = 0.05, group = G_F, display = display.none)
showFib    = input.bool(true, "Show the 79% level", group = G_F, display = display.none)

G_G = "Fair value gaps"
minGapAtr  = input.float(0.15, "Smallest gap (x ATR)", minval = 0.0, step = 0.05, group = G_G, display = display.none)
maxGaps    = input.int(20, "Gaps to track", minval = 4, maxval = 60, group = G_G, display = display.none)
maxGapAge  = input.int(400, "Forget gaps older than (bars)", minval = 50, maxval = 2000, group = G_G, display = display.none)
ofMemory   = input.int(10, "Order-flow memory (events)", minval = 3, maxval = 50, group = G_G, display = display.none)
maxDrawn   = input.int(6, "Zones to draw (nearest to price)", minval = 1, maxval = 20, group = G_G, display = display.none)
showFvg    = input.bool(true, "Show FVGs", group = G_G, display = display.none)
showIfvg   = input.bool(true, "Show inverse FVGs", group = G_G, display = display.none)

G_D = "Delta and volume"
deltaTf    = input.timeframe("1", "Delta from intrabars of", group = G_D, display = display.none)
rvolLen    = input.int(20, "Volume average length", minval = 5, group = G_D, display = display.none)
minRvol    = input.float(1.0, "Relative volume that counts", minval = 0.0, step = 0.1, group = G_D, display = display.none)
dzLen      = input.int(30, "Delta z-score lookback (bars)", minval = 10, maxval = 100, group = G_D, display = display.none)
dzMin      = input.float(1.5, "Unusual delta (z-score)", minval = 0.5, step = 0.1, group = G_D, display = display.none)
buyDomPct  = input.float(60, "One side dominates at (% of volume)", minval = 51, maxval = 90, step = 1, group = G_D, display = display.none)
cvdBars    = input.int(5, "CVD trend over (bars)", minval = 2, maxval = 30, group = G_D, display = display.none)
showBig    = input.bool(true, "Mark big prints", tooltip = "A circle where one intrabar traded far more than usual: green if it closed up, red if down. The bigger the print, the bigger the circle, in five sizes: past the threshold, 1.5x, 2.25x, 3.5x and 5x it. The closest Pine gets to Bookmap-style trade bubbles.", group = G_D, display = display.none)
bigMult    = input.float(4.0, "Big print at (x average intrabar volume)", minval = 2.0, step = 0.5, group = G_D, display = display.none)

G_M = "Timeframes"
tf1       = input.timeframe("5", "Timeframe 1", group = G_M, display = display.none)
tf2       = input.timeframe("15", "Timeframe 2", group = G_M, display = display.none)
tf3       = input.timeframe("30", "Timeframe 3", group = G_M, display = display.none)
htfFilter = input.string("Timeframe 3", "Trend filter", options = ["Off", "Timeframe 2", "Timeframe 3", "Majority"], group = G_M, display = display.none)

G_T = "Sessions (New York time)"
useSess    = input.bool(true, "Only signal inside a session", group = G_T, display = display.none)
sessLdn    = input.session("0200-0500", "London", group = G_T, display = display.none)
sessNyAm   = input.session("0830-1100", "New York AM", group = G_T, display = display.none)
sessNyPm   = input.session("1330-1530", "New York PM", group = G_T, display = display.none)
showSessBg = input.bool(false, "Shade sessions", group = G_T, display = display.none)

G_E = "Entries and exits"
minScore   = input.int(5, "Minimum score to signal (of 8)", minval = 3, maxval = 8, group = G_E, display = display.none)
stopAtr    = input.float(0.25, "Stop buffer (x ATR)", minval = 0.0, step = 0.05, group = G_E, display = display.none)
maxRiskAtr = input.float(3.0, "Skip if the stop is wider than (x ATR)", minval = 0.5, step = 0.25, group = G_E, display = display.none)
tp1R       = input.float(1.0, "Target 1 (R)", minval = 0.25, step = 0.25, group = G_E, display = display.none)
tp2R       = input.float(2.0, "Target 2 (R)", minval = 0.5, step = 0.25, group = G_E, display = display.none)
beAfterTp1 = input.bool(true, "Stop to breakeven after target 1", group = G_E, display = display.none)
exitOnFlip = input.bool(true, "Exit when structure flips", group = G_E, display = display.none)
exitOnOf   = input.bool(true, "Exit when order flow is disrespected", group = G_E, display = display.none)

G_V = "Dashboard"
dashPos  = input.string("Top right", "Position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G_V, display = display.none)
dashSize = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = G_V, display = display.none)

G_X = "Strategies"
showBest    = input.bool(true, "Show the best long / short table", group = G_X, display = display.none)
bestPos     = input.string("Bottom right", "Best long / short table position", options = ["Bottom right", "Middle right", "Bottom left", "Middle left", "Top left"], group = G_X, display = display.none)
stratLabels = input.bool(true, "Show strategy signals on the chart", group = G_X, display = display.none)
minRR       = input.float(1.0, "Skip trades with less reward than (R)", minval = 0.25, step = 0.25, group = G_X, display = display.none)
useBO = input.bool(true, "Breakout", group = G_X, inline = "s1", display = display.none)
usePB = input.bool(true, "Pullback", group = G_X, inline = "s1", display = display.none)
useRG = input.bool(true, "Range", group = G_X, inline = "s2", display = display.none)
useMR = input.bool(true, "Mean reversion", group = G_X, inline = "s2", display = display.none)
useNW = input.bool(true, "News", group = G_X, inline = "s3", display = display.none)
useSP = input.bool(true, "Spread", group = G_X, inline = "s3", display = display.none)
useSC = input.bool(true, "Scalping", group = G_X, inline = "s4", display = display.none)
useOF = input.bool(true, "Order flow", group = G_X, inline = "s4", display = display.none)

G_X1 = "Breakout"
boLen     = input.int(20, "Consolidation length (bars)", minval = 5, maxval = 200, group = G_X1, display = display.none)
boMaxAtr  = input.float(3.0, "Tight if the range is under (x ATR)", minval = 0.5, step = 0.25, group = G_X1, display = display.none)
boVolMult = input.float(1.5, "Breakout volume (x average)", minval = 1.0, step = 0.1, group = G_X1, display = display.none)

G_X2 = "Pullback"
pbFastLen = input.int(20, "Fast EMA", minval = 5, maxval = 100, group = G_X2, display = display.none)
pbSlowLen = input.int(50, "Slow EMA", minval = 10, maxval = 300, group = G_X2, display = display.none)

G_X3 = "Range"
rgLen    = input.int(40, "Range length (bars)", minval = 10, maxval = 300, group = G_X3, display = display.none)
rgAdxMax = input.float(25, "Ranging when ADX is under", minval = 10, maxval = 50, group = G_X3, display = display.none)
rgTouch  = input.int(2, "Touches needed on each side", minval = 1, maxval = 5, group = G_X3, display = display.none)

G_X4 = "Mean reversion"
bbLen     = input.int(20, "Bollinger length", minval = 5, maxval = 200, group = G_X4, display = display.none)
bbMult    = input.float(2.0, "Bollinger width (std dev)", minval = 1.0, step = 0.5, group = G_X4, display = display.none)
rsiLo     = input.int(30, "RSI oversold", minval = 5, maxval = 50, group = G_X4, display = display.none)
rsiHi     = input.int(70, "RSI overbought", minval = 50, maxval = 95, group = G_X4, display = display.none)
mrNeedDiv = input.bool(false, "Require RSI divergence", group = G_X4, display = display.none)
mrTarget  = input.string("Band middle", "Target", options = ["Band middle", "VWAP"], group = G_X4, display = display.none)

G_X5 = "News"
nwTimes    = input.string("0830,1000,1400", "Release times, New York (HHMM, comma separated)", group = G_X5, display = display.none)
nwWaitMin  = input.int(10, "Wait after the release (minutes)", minval = 0, maxval = 60, group = G_X5, display = display.none)
nwSpikeAtr = input.float(1.5, "A spike needs a range of (x ATR)", minval = 0.5, step = 0.25, group = G_X5, display = display.none)
nwTpR      = input.float(1.5, "Target (R)", minval = 0.5, step = 0.25, group = G_X5, display = display.none)

G_X6 = "Spread"
spSymIn   = input.string("Auto", "Pair symbol", tooltip = "Auto pairs NQ with ES and gold with silver. Or type a ticker such as CME_MINI:ES1!", group = G_X6, display = display.none)
spLen     = input.int(100, "Lookback (bars)", minval = 20, maxval = 1000, group = G_X6, display = display.none)
spEntryZ  = input.float(2.0, "Enter beyond z-score", minval = 1.0, step = 0.25, group = G_X6, display = display.none)
spStopZ   = input.float(3.5, "Stop beyond z-score", minval = 2.0, step = 0.25, group = G_X6, display = display.none)
spMinCorr = input.float(0.6, "Minimum correlation", minval = 0.0, maxval = 1.0, step = 0.05, group = G_X6, display = display.none)

G_X7 = "Scalping"
scStopAtr = input.float(0.5, "Stop (x ATR)", minval = 0.1, step = 0.05, group = G_X7, display = display.none)
