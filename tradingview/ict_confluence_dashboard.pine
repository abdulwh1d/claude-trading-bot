//@version=6
indicator("ICT Confluence Dashboard", shorttitle = "ICT Dash", overlay = true, max_boxes_count = 300, max_lines_count = 500, max_labels_count = 500, max_bars_back = 1000)

// ============================================================================
// ICT Confluence Dashboard
// Break of structure, the 79% retracement, fair value gaps and inverse FVGs,
// order flow respected or disrespected, intrabar delta (judged by z-score, share
// of volume and the CVD trend), a SuperFlow-style flow score, big prints,
// relative volume and session timing, for 5-30 minute futures charts (NQ/MNQ,
// ES/MES, GC/MGC). Signals print on candle close only, so they don't repaint.
// Ten more playbooks run alongside: breakout, pullback, range, mean reversion,
// news, spread, scalping, order flow, GEX + order flow and GEX + anchored VWAP,
// each with its own signals, stop, target and record. A side table shows the best
// long and short among them. GEX levels (dealer gamma, from gex/gex_levels.py),
// today's busiest option strikes and Kronos forecasts are drawn when the levels
// file is pasted into the settings.
// An engineering tool, not financial advice. History stats ignore fees and
// slippage.
// ============================================================================

// ------------------------------------------------------------------ inputs --
G_S = "Structure"
swingLen     = input.int(5, "Swing length (bars on each side)", minval = 2, maxval = 20, group = G_S, display = display.none)
breakOnClose = input.bool(true, "A break needs a candle close beyond the swing", group = G_S, display = display.none)
showBos      = input.bool(true, "Show BOS / CHoCH", group = G_S, display = display.none)

G_F = "Fibonacci"
fibLevel   = input.float(0.79, "Entry retracement", minval = 0.5, maxval = 0.95, step = 0.01, group = G_F, display = display.none)
fibTolAtr  = input.float(0.10, "Touch tolerance (x ATR)", minval = 0.0, step = 0.05, group = G_F, display = display.none)
showFib    = input.bool(true, "Show the 79% level", group = G_F, display = display.none)

G_G = "Fair value gaps"
minGapAtr  = input.float(0.15, "Smallest gap (x ATR)", minval = 0.0, step = 0.05, group = G_G, display = display.none)
maxGaps    = input.int(20, "Gaps to track", minval = 4, maxval = 60, group = G_G, display = display.none)
maxGapAge  = input.int(400, "Forget gaps older than (bars)", minval = 50, maxval = 2000, group = G_G, display = display.none)
ofMemory   = input.int(10, "Order-flow memory (events)", minval = 3, maxval = 50, group = G_G, display = display.none)
maxDrawn   = input.int(6, "Zones to draw (nearest to price)", minval = 1, maxval = 20, group = G_G, display = display.none)
showFvg    = input.bool(true, "Show FVGs", group = G_G, display = display.none)
showIfvg   = input.bool(true, "Show inverse FVGs", group = G_G, display = display.none)

G_D = "Delta and volume"
deltaTf    = input.timeframe("1", "Delta from intrabars of", group = G_D, display = display.none)
rvolLen    = input.int(20, "Volume average length", minval = 5, group = G_D, display = display.none)
minRvol    = input.float(1.0, "Relative volume that counts", minval = 0.0, step = 0.1, group = G_D, display = display.none)
dzLen      = input.int(30, "Delta z-score lookback (bars)", minval = 10, maxval = 100, group = G_D, display = display.none)
dzMin      = input.float(1.5, "Unusual delta (z-score)", minval = 0.5, step = 0.1, group = G_D, display = display.none)
buyDomPct  = input.float(60, "One side dominates at (% of volume)", minval = 51, maxval = 90, step = 1, group = G_D, display = display.none)
cvdBars    = input.int(5, "CVD trend over (bars)", minval = 2, maxval = 30, group = G_D, display = display.none)
showBig    = input.bool(true, "Mark big prints", tooltip = "A circle where one intrabar traded far more than usual: green if it closed up, red if down. The bigger the print, the bigger the circle, in five sizes: past the threshold, 1.5x, 2.25x, 3.5x and 5x it. The closest Pine gets to Bookmap-style trade bubbles.", group = G_D, display = display.none)
bigMult    = input.float(4.0, "Big print at (x average intrabar volume)", minval = 2.0, step = 0.5, group = G_D, display = display.none)

G_M = "Timeframes"
tf1       = input.timeframe("5", "Timeframe 1", group = G_M, display = display.none)
tf2       = input.timeframe("15", "Timeframe 2", group = G_M, display = display.none)
tf3       = input.timeframe("30", "Timeframe 3", group = G_M, display = display.none)
htfFilter = input.string("Timeframe 3", "Trend filter", options = ["Off", "Timeframe 2", "Timeframe 3", "Majority"], group = G_M, display = display.none)

G_T = "Sessions (New York time)"
useSess    = input.bool(true, "Only signal inside a session", group = G_T, display = display.none)
sessLdn    = input.session("0200-0500", "London", group = G_T, display = display.none)
sessNyAm   = input.session("0830-1100", "New York AM", group = G_T, display = display.none)
sessNyPm   = input.session("1330-1530", "New York PM", group = G_T, display = display.none)
showSessBg = input.bool(false, "Shade sessions", group = G_T, display = display.none)

G_E = "Entries and exits"
minScore   = input.int(5, "Minimum score to signal (of 8)", minval = 3, maxval = 8, group = G_E, display = display.none)
stopAtr    = input.float(0.25, "Stop buffer (x ATR)", minval = 0.0, step = 0.05, group = G_E, display = display.none)
maxRiskAtr = input.float(3.0, "Skip if the stop is wider than (x ATR)", minval = 0.5, step = 0.25, group = G_E, display = display.none)
tp1R       = input.float(1.0, "Target 1 (R)", minval = 0.25, step = 0.25, group = G_E, display = display.none)
tp2R       = input.float(2.0, "Target 2 (R)", minval = 0.5, step = 0.25, group = G_E, display = display.none)
beAfterTp1 = input.bool(true, "Stop to breakeven after target 1", group = G_E, display = display.none)
exitOnFlip = input.bool(true, "Exit when structure flips", group = G_E, display = display.none)
exitOnOf   = input.bool(true, "Exit when order flow is disrespected", group = G_E, display = display.none)

G_V = "Dashboard"
dashPos  = input.string("Top right", "Position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G_V, display = display.none)
dashSize = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = G_V, display = display.none)

G_X = "Strategies"
showBest    = input.bool(true, "Show the best long / short table", group = G_X, display = display.none)
bestPos     = input.string("Bottom right", "Best long / short table position", options = ["Bottom right", "Middle right", "Bottom left", "Middle left", "Top left"], group = G_X, display = display.none)
stratLabels = input.bool(true, "Show strategy signals on the chart", group = G_X, display = display.none)
minRR       = input.float(1.0, "Skip trades with less reward than (R)", minval = 0.25, step = 0.25, group = G_X, display = display.none)
useBO = input.bool(true, "Breakout", group = G_X, inline = "s1", display = display.none)
usePB = input.bool(true, "Pullback", group = G_X, inline = "s1", display = display.none)
useRG = input.bool(true, "Range", group = G_X, inline = "s2", display = display.none)
useMR = input.bool(true, "Mean reversion", group = G_X, inline = "s2", display = display.none)
useNW = input.bool(true, "News", group = G_X, inline = "s3", display = display.none)
useSP = input.bool(true, "Spread", group = G_X, inline = "s3", display = display.none)
useSC = input.bool(true, "Scalping", group = G_X, inline = "s4", display = display.none)
useOF = input.bool(true, "Order flow", group = G_X, inline = "s4", display = display.none)

G_X1 = "Breakout"
boLen     = input.int(20, "Consolidation length (bars)", minval = 5, maxval = 200, group = G_X1, display = display.none)
boMaxAtr  = input.float(3.0, "Tight if the range is under (x ATR)", minval = 0.5, step = 0.25, group = G_X1, display = display.none)
boVolMult = input.float(1.5, "Breakout volume (x average)", minval = 1.0, step = 0.1, group = G_X1, display = display.none)

G_X2 = "Pullback"
pbFastLen = input.int(20, "Fast EMA", minval = 5, maxval = 100, group = G_X2, display = display.none)
pbSlowLen = input.int(50, "Slow EMA", minval = 10, maxval = 300, group = G_X2, display = display.none)

G_X3 = "Range"
rgLen    = input.int(40, "Range length (bars)", minval = 10, maxval = 300, group = G_X3, display = display.none)
rgAdxMax = input.float(25, "Ranging when ADX is under", minval = 10, maxval = 50, group = G_X3, display = display.none)
rgTouch  = input.int(2, "Touches needed on each side", minval = 1, maxval = 5, group = G_X3, display = display.none)

G_X4 = "Mean reversion"
bbLen     = input.int(20, "Bollinger length", minval = 5, maxval = 200, group = G_X4, display = display.none)
bbMult    = input.float(2.0, "Bollinger width (std dev)", minval = 1.0, step = 0.5, group = G_X4, display = display.none)
rsiLo     = input.int(30, "RSI oversold", minval = 5, maxval = 50, group = G_X4, display = display.none)
rsiHi     = input.int(70, "RSI overbought", minval = 50, maxval = 95, group = G_X4, display = display.none)
mrNeedDiv = input.bool(false, "Require RSI divergence", group = G_X4, display = display.none)
mrTarget  = input.string("Band middle", "Target", options = ["Band middle", "VWAP"], group = G_X4, display = display.none)

G_X5 = "News"
nwTimes    = input.string("0830,1000,1400", "Release times, New York (HHMM, comma separated)", group = G_X5, display = display.none)
nwWaitMin  = input.int(10, "Wait after the release (minutes)", minval = 0, maxval = 60, group = G_X5, display = display.none)
nwSpikeAtr = input.float(1.5, "A spike needs a range of (x ATR)", minval = 0.5, step = 0.25, group = G_X5, display = display.none)
nwTpR      = input.float(1.5, "Target (R)", minval = 0.5, step = 0.25, group = G_X5, display = display.none)

G_X6 = "Spread"
spSymIn   = input.string("Auto", "Pair symbol", tooltip = "Auto pairs NQ with ES and gold with silver. Or type a ticker such as CME_MINI:ES1!", group = G_X6, display = display.none)
spLen     = input.int(100, "Lookback (bars)", minval = 20, maxval = 1000, group = G_X6, display = display.none)
spEntryZ  = input.float(2.0, "Enter beyond z-score", minval = 1.0, step = 0.25, group = G_X6, display = display.none)
spStopZ   = input.float(3.5, "Stop beyond z-score", minval = 2.0, step = 0.25, group = G_X6, display = display.none)
spMinCorr = input.float(0.6, "Minimum correlation", minval = 0.0, maxval = 1.0, step = 0.05, group = G_X6, display = display.none)

G_X7 = "Scalping"
scStopAtr = input.float(0.5, "Stop (x ATR)", minval = 0.1, step = 0.05, group = G_X7, display = display.none)
scTpR     = input.float(1.25, "Target (R)", minval = 0.5, step = 0.25, group = G_X7, display = display.none)

G_X8 = "Order flow"
ofAbsRvol  = input.float(1.8, "Absorption volume (x average)", minval = 1.0, step = 0.1, group = G_X8, display = display.none)
ofAbsDelta = input.int(20, "Absorption delta (% of the bar's volume)", minval = 5, maxval = 90, group = G_X8, display = display.none)

G_GX = "GEX levels"
gexText   = input.text_area("", "GEX levels (paste gex/history.txt)", tooltip = "Copy gex/history.txt from your GitHub repo (updated every weekday morning) and paste it here. It holds every snapshot, so the GEX signal's record covers past days too. gex/latest.txt works as well (today only). Pine reads at most 40,960 characters; history.txt is kept under that.", group = G_GX, display = display.none)
gexUnd    = input.string("Auto", "Options underlying", options = ["Auto", "SPX", "SPY", "NDX", "QQQ", "RUT", "IWM", "DIA", "GLD", "SLV", "USO", "UNG", "TLT"], tooltip = "Auto: NQ uses NDX, ES SPX, RTY RUT, YM DIA, gold GLD, silver SLV, crude USO, natural gas UNG, bonds TLT. The ETF-based ones (gold, silver, crude, gas, bonds) are rougher: the ETF's options stand in for the futures'.", group = G_GX, display = display.none)
showGex   = input.bool(true, "Draw GEX levels", group = G_GX, display = display.none)
gexSpikes = input.int(12, "GEX levels to label", minval = 0, maxval = 30, tooltip = "The biggest strikes in the ladder get a label with their price and GEX.", group = G_GX, display = display.none)
gexTolAtr = input.float(0.3, "At a GEX level when within (x ATR)", minval = 0.05, step = 0.05, group = G_GX, display = display.none)
useGX     = input.bool(true, "GEX + order flow signals", group = G_GX, display = display.none)
gexRange  = input.float(1.5, "Ladder range (% from price)", minval = 0.25, maxval = 2.0, step = 0.25, tooltip = "Every strike within this distance of price is drawn: green for positive GEX, red for negative, bolder for more. The levels file covers 2%.", group = G_GX, display = display.none)
gexMode   = input.string("Trusted only", "GEX levels to show", options = ["Trusted only", "Strong levels", "Full ladder"], tooltip = "Trusted only: the call wall, the put wall and the gamma flip, plus a big-GEX strike only where today's option volume is heavy too (★ flow) and only until it breaks. The GEX signals use the same levels. Strong levels: the walls, the flip and the 8 biggest strikes. Full ladder: every strike in range. Gold, silver, crude, gas and bonds use an ETF's options, so Trusted only shows just their walls and flip.", group = G_GX, display = display.none)
showOV    = input.bool(true, "Mark options-flow levels", tooltip = "Today's busiest option strikes near price, from the same CBOE chains: teal when calls dominate, pink when puts do. Works on every timeframe (TradingView's Options Volume Profile only draws on 1D and up).", group = G_GX, display = display.none)
nOV       = input.int(4, "Options-flow levels to mark", minval = 1, maxval = 8, group = G_GX, display = display.none)
showFC    = input.bool(true, "Kronos forecast row", tooltip = "Kronos, an open-source model trained on candlestick charts, forecasts the next 2 hours every 30 minutes in the GitHub Action (NQ, ES, RTY, YM, gold). The row shows the forecast and how often its 1-hour direction call was right lately. An experiment, not a signal.", group = G_GX, display = display.none)

G_GA = "GEX + anchored VWAP"
useGA     = input.bool(true, "GEX + AVWAP signals", tooltip = "GEX says where price may turn; a VWAP anchored at the start of the move into the level says whether that move is still in control. Reversal: price reacts at the level and closes back through the AVWAP. Continuation: price breaks the level while the AVWAP holds, then retests the level.", group = G_GA, display = display.none)
gaShow    = input.bool(true, "Draw the anchored VWAP", group = G_GA, display = display.none)
gaLook    = input.int(48, "Look back for the move's start (bars)", minval = 10, maxval = 300, group = G_GA, display = display.none)
gaWait    = input.int(24, "Bars to wait for the trigger", minval = 3, maxval = 200, group = G_GA, display = display.none)
gaMinMove = input.float(1.5, "Smallest move into the level (x ATR)", minval = 0.5, step = 0.25, group = G_GA, display = display.none)

// ------------------------------------------------------------------ colors --
cBull  = color.new(#16a34a, 0)
cBear  = color.new(#dc2626, 0)
cNeu   = color.new(#94a3b8, 0)
cText  = color.new(#e2e8f0, 0)
cKey   = color.new(#94a3b8, 0)
cWarn  = color.new(#f59e0b, 0)
cGA    = color.new(#a855f7, 0)
cOVc   = color.new(#22d3ee, 0)
cOVp   = color.new(#f472b6, 0)

// ----------------------------------------------------------------- helpers --
f_k(float x) =>
    na(x) ? "–" : x >= 1000 ? str.tostring(x / 1000, "#.#") + "k" : str.tostring(x, "#")

f_px(float x) =>
    na(x) ? "–" : str.tostring(x, format.mintick)

f_tf(string tf) =>
    float mins = str.tonumber(tf)
    string out = tf
    if not na(mins)
        out := mins >= 60 and mins % 60 == 0 ? str.tostring(mins / 60, "#") + "h" : str.tostring(mins, "#") + "m"
    out

f_arrow(int t) =>
    t == 1 ? "▲" : t == -1 ? "▼" : "–"

f_color(int t) =>
    t == 1 ? cBull : t == -1 ? cBear : cNeu

f_check(bool ok) =>
    ok ? "✓" : "✗"

f_signed(float x, string fmt) =>
    string s = str.tostring(x, fmt)
    s := s == "-0" ? "0" : s
    (x > 0 and s != "0" ? "+" : "") + s

// Market structure for the timeframe rows: 1 after a bullish break, -1 after a bearish one.
f_structure(int len) =>
    float hp = ta.pivothigh(high, len, len)
    float lp = ta.pivotlow(low, len, len)
    var float sh = na
    var float sl = na
    var int t = 0
    if not na(hp)
        sh := hp
    if not na(lp)
        sl := lp
    if not na(sh) and close > sh
        t := 1
        sh := na
    if not na(sl) and close < sl
        t := -1
        sl := na
    t

atr  = ta.atr(14)
mintickSafe = syminfo.mintick > 0 ? syminfo.mintick : 0.01
var int firstBarTime = time
string sinceTxt = "since " + str.format_time(firstBarTime, "MMM d, yyyy", "America/New_York")

// ------------------------------------------------- delta from intrabars ---
// Each intrabar's volume counts as buying if it closed up (or, when flat, above the
// previous intrabar close) and as selling if it closed down. A close-enough stand-in
// for real bid/ask delta, which TradingView only exposes on its top plans.
[ltfO, ltfC, ltfV] = request.security_lower_tf(syminfo.tickerid, deltaTf, [open, close, volume])
float buyVol  = 0.0
float sellVol = 0.0
int nIntra = array.size(ltfV)
if nIntra > 0
    for i = 0 to nIntra - 1
        float o = array.get(ltfO, i)
        float c = array.get(ltfC, i)
        float v = nz(array.get(ltfV, i))
        float pc = i > 0 ? array.get(ltfC, i - 1) : nz(close[1], o)
        if c > o or (c == o and c > pc)
            buyVol += v
        else if c < o or (c == o and c < pc)
            sellVol += v
        else
            buyVol += v * 0.5
            sellVol += v * 0.5
else
    float v0 = nz(volume)
    if close > open
        buyVol := v0
    else if close < open
        sellVol := v0
    else
        buyVol := v0 * 0.5
        sellVol := v0 * 0.5
float delta    = buyVol - sellVol
float deltaPct = nz(volume) > 0 ? delta / volume : 0.0

bool newDay = timeframe.change("D")
var float cvd = 0.0
cvd := newDay ? delta : cvd + delta
var int dayIdx = 0
if newDay
    dayIdx += 1
// Delta judged against its own recent history and against total volume, and the
// trend of cumulative delta over several bars rather than one spike.
float buyPct     = buyVol + sellVol > 0 ? 100 * buyVol / (buyVol + sellVol) : 50.0
float dMean      = ta.sma(delta, dzLen)
float dSd        = ta.stdev(delta, dzLen)
float deltaZ     = dSd > 0 ? (delta - dMean) / dSd : 0.0
bool  buyersDom  = deltaZ >= dzMin or buyPct >= buyDomPct
bool  sellersDom = deltaZ <= -dzMin or buyPct <= 100 - buyDomPct
float cvdChg     = math.sum(delta, cvdBars)
float upBars     = math.sum(delta > 0 ? 1 : 0, cvdBars)
float downBars   = math.sum(delta < 0 ? 1 : 0, cvdBars)
bool  cvdRising  = cvdChg > 0 and upBars >= math.ceil(0.6 * cvdBars)
bool  cvdFalling = cvdChg < 0 and downBars >= math.ceil(0.6 * cvdBars)

// Big prints: intrabars that traded far more than usual, signed by their direction.
// After the trade bubbles of Bookmap-style tools (Azhagesan-dev/OrderFlowMap) and
// SuperFlow's big-trades signal, built from intrabars instead of single trades.
float ltfMean   = nIntra > 0 ? nz(volume) / nIntra : nz(volume)
float bigRef    = ta.sma(ltfMean, 50)
float bigThr    = bigMult * nz(bigRef[1], nz(bigRef, ltfMean))
float btSum     = 0.0
int   btN       = 0
float bigBuyPx  = na
float bigSellPx = na
float bigBuyV   = 0.0
float bigSellV  = 0.0
if nIntra > 0 and bigThr > 0
    for i = 0 to nIntra - 1
        float bv = nz(array.get(ltfV, i))
        if bv >= bigThr
            float bo = array.get(ltfO, i)
            float bc = array.get(ltfC, i)
            float sg = bc > bo ? 1.0 : bc < bo ? -1.0 : 0.0
            btSum += sg * math.min(1.0, bv / (3 * bigThr))
            btN += 1
            if sg > 0 and bv > bigBuyV
                bigBuyV := bv
                bigBuyPx := bc
            else if sg < 0 and bv > bigSellV
                bigSellV := bv
                bigSellPx := bc

// ------------------------------------------------------------------ volume --
float volAvg = ta.sma(volume, rvolLen)
float rvol   = nz(volAvg) > 0 ? volume / volAvg : 0.0

// ---------------------------------------------------------------- sessions --
bool inLdn  = not na(time(timeframe.period, sessLdn, "America/New_York"))
bool inNyAm = not na(time(timeframe.period, sessNyAm, "America/New_York"))
bool inNyPm = not na(time(timeframe.period, sessNyPm, "America/New_York"))
bool inSess = inLdn or inNyAm or inNyPm
string sessName = inNyAm ? "New York AM" : inNyPm ? "New York PM" : inLdn ? "London" : "Outside sessions"
bgcolor(showSessBg and inSess ? color.new(#3b82f6, 93) : na, title = "Sessions")

// --------------------------------------------------------------- structure --
float ph = ta.pivothigh(high, swingLen, swingLen)
float pl = ta.pivotlow(low, swingLen, swingLen)

var float swingHigh = na
var int   swingHighBar = na
var bool  swingHighTaken = true
var float swingLow = na
var int   swingLowBar = na
var bool  swingLowTaken = true
var int   trend = 0

if not na(ph)
    swingHigh := ph
    swingHighBar := bar_index - swingLen
    swingHighTaken := false
if not na(pl)
    swingLow := pl
    swingLowBar := bar_index - swingLen
    swingLowTaken := false

int lenSinceSH = na(swingHighBar) ? 1 : math.max(1, math.min(bar_index - swingHighBar + 1, 500))
int lenSinceSL = na(swingLowBar) ? 1 : math.max(1, math.min(bar_index - swingLowBar + 1, 500))
float lowSinceSH   = ta.lowest(low, lenSinceSH)
int   lowSinceSHAt = ta.lowestbars(low, lenSinceSH)
float highSinceSL   = ta.highest(high, lenSinceSL)
int   highSinceSLAt = ta.highestbars(high, lenSinceSL)

float upSrc = breakOnClose ? close : high
float dnSrc = breakOnClose ? close : low
bool bullBreak = not swingHighTaken and not na(swingHigh) and upSrc > swingHigh
bool bearBreak = not swingLowTaken and not na(swingLow) and dnSrc < swingLow
if bullBreak and bearBreak   // one huge candle through both swings: trust its close
    bullBreak := close >= open
    bearBreak := not bullBreak

// The leg the 79% retracement is measured on.
var int   legDir = 0          // 1 bullish leg (long setups), -1 bearish leg (short setups)
var float legLow = na
var float legHigh = na
var int   legOriginBar = na
var int   fibTouchBar = na
bool bullChoch = false
bool bearChoch = false

if bullBreak
    bullChoch := trend == -1
    trend := 1
    swingHighTaken := true
    legDir := 1
    legLow := lowSinceSH
    legOriginBar := bar_index + lowSinceSHAt
    legHigh := high
    fibTouchBar := na
    if showBos
        line.new(swingHighBar, swingHigh, bar_index, swingHigh, color = cBull, style = bullChoch ? line.style_dashed : line.style_solid, width = 1)
        label.new(math.round((swingHighBar + bar_index) / 2), swingHigh, bullChoch ? "CHoCH" : "BOS", style = label.style_label_down, color = color.new(cBull, 100), textcolor = cBull, size = size.tiny)
if bearBreak
    bearChoch := trend == 1
    trend := -1
    swingLowTaken := true
    legDir := -1
    legHigh := highSinceSL
    legOriginBar := bar_index + highSinceSLAt
    legLow := low
    fibTouchBar := na
    if showBos
        line.new(swingLowBar, swingLow, bar_index, swingLow, color = cBear, style = bearChoch ? line.style_dashed : line.style_solid, width = 1)
        label.new(math.round((swingLowBar + bar_index) / 2), swingLow, bearChoch ? "CHoCH" : "BOS", style = label.style_label_up, color = color.new(cBear, 100), textcolor = cBear, size = size.tiny)

// Extend the leg to new extremes until price pulls back to the 79% level.
if legDir == 1 and not bullBreak and na(fibTouchBar)
    legHigh := math.max(legHigh, high)
if legDir == -1 and not bearBreak and na(fibTouchBar)
    legLow := math.min(legLow, low)

float legRange = legHigh - legLow
float fib79 = legDir == 1 ? legHigh - fibLevel * legRange : legDir == -1 ? legLow + fibLevel * legRange : na
float fib50 = (legHigh + legLow) / 2
float fibTol = fibTolAtr * atr
bool fibTouchLong  = legDir == 1 and not bullBreak and low <= fib79 + fibTol and close > legLow
bool fibTouchShort = legDir == -1 and not bearBreak and high >= fib79 - fibTol and close < legHigh
if fibTouchLong or fibTouchShort
    fibTouchBar := bar_index
// A close beyond the leg's origin kills the setup.
if legDir == 1 and close < legLow
    legDir := 0
if legDir == -1 and close > legHigh
    legDir := 0
bool fibRecent = not na(fibTouchBar) and bar_index - fibTouchBar <= 3
bool fibLong  = legDir == 1 and fibRecent and close < fib50
bool fibShort = legDir == -1 and fibRecent and close > fib50

// ------------------------------------------------ fair value gaps / IFVGs ---
type Gap
    float top
    float bot
    int   dir       // 1 = support (bullish), -1 = resistance (bearish)
    bool  inverse   // true once price closed through it and it flipped (IFVG)
    int   born
    box   bx

var array<Gap> gaps = array.new<Gap>()
var array<int> ofEvents = array.new<int>()   // 1 support held, 2 support broken, 3 resistance held, 4 resistance broken
var int ofScore = 0

f_styleGap(Gap g, bool show) =>
    if not na(g.bx)
        color base = g.dir == 1 ? cBull : cBear
        color clear = color.new(color.black, 100)
        box.set_bgcolor(g.bx, show ? color.new(base, g.inverse ? 90 : 86) : clear)
        box.set_border_color(g.bx, show ? color.new(base, g.inverse ? 25 : 65) : clear)
        box.set_border_style(g.bx, g.inverse ? line.style_dashed : line.style_solid)
        box.set_text(g.bx, show ? (g.inverse ? "IFVG" : "FVG") : "")
        box.set_text_color(g.bx, show ? color.new(base, 30) : clear)

bool newBullGap = low > high[2] and (low - high[2]) >= minGapAtr * atr
bool newBearGap = high < low[2] and (low[2] - high) >= minGapAtr * atr

bool supportHeld   = false
bool supportBroken = false
bool resistHeld    = false
bool resistBroken  = false
bool supportTouched = false
bool resistTouched  = false
float heldZoneBot = na
float heldZoneTop = na
int eventsThisBar = 0

if array.size(gaps) > 0
    for i = array.size(gaps) - 1 to 0
        Gap g = array.get(gaps, i)
        if bar_index - g.born > maxGapAge
            if not na(g.bx)
                box.set_right(g.bx, bar_index)
                box.set_extend(g.bx, extend.none)
            array.remove(gaps, i)
            continue
        float mid = (g.top + g.bot) / 2
        if g.dir == 1
            if close < g.bot
                supportBroken := true
                array.push(ofEvents, 2)
                ofScore -= 1
                if g.inverse or not showIfvg
                    if not na(g.bx)
                        box.set_right(g.bx, bar_index)
                        box.set_extend(g.bx, extend.none)
                    if g.inverse
                        array.remove(gaps, i)
                    else
                        g.dir := -1
                        g.inverse := true
                        g.bx := na
                else
                    g.dir := -1
                    g.inverse := true
                    f_styleGap(g, true)
            else if low <= g.top
                supportTouched := true
                if close > open and close >= mid
                    supportHeld := true
                    array.push(ofEvents, 1)
                    ofScore += 1
                    heldZoneBot := na(heldZoneBot) ? g.bot : math.min(heldZoneBot, g.bot)
        else
            if close > g.top
                resistBroken := true
                array.push(ofEvents, 4)
                ofScore += 1
                if g.inverse or not showIfvg
                    if not na(g.bx)
                        box.set_right(g.bx, bar_index)
                        box.set_extend(g.bx, extend.none)
                    if g.inverse
                        array.remove(gaps, i)
                    else
                        g.dir := 1
                        g.inverse := true
                        g.bx := na
                else
                    g.dir := 1
                    g.inverse := true
                    f_styleGap(g, true)
            else if high >= g.bot
                resistTouched := true
                if close < open and close <= mid
                    resistHeld := true
                    array.push(ofEvents, 3)
                    ofScore -= 1
                    heldZoneTop := na(heldZoneTop) ? g.top : math.max(heldZoneTop, g.top)

// Keep only the most recent order-flow events.
while array.size(ofEvents) > ofMemory
    int old = array.shift(ofEvents)
    ofScore -= (old == 1 or old == 4) ? 1 : -1

// Register the new gaps after checking the old ones, so a gap is never tested on its own candle.
if newBullGap
    box b = showFvg ? box.new(bar_index - 2, low, bar_index, high[2], extend = extend.right, text_size = size.tiny, text_halign = text.align_right) : na
    Gap ng = Gap.new(low, high[2], 1, false, bar_index, b)
    f_styleGap(ng, true)
    array.unshift(gaps, ng)
if newBearGap
    box b = showFvg ? box.new(bar_index - 2, low[2], bar_index, high, extend = extend.right, text_size = size.tiny, text_halign = text.align_right) : na
    Gap ng = Gap.new(low[2], high, -1, false, bar_index, b)
    f_styleGap(ng, true)
    array.unshift(gaps, ng)
while array.size(gaps) > maxGaps
    Gap oldGap = array.pop(gaps)
    if not na(oldGap.bx)
        box.set_right(oldGap.bx, bar_index)
        box.set_extend(oldGap.bx, extend.none)

if barstate.islast and array.size(gaps) > 0
    array<float> dist = array.new<float>()
    for i = 0 to array.size(gaps) - 1
        Gap g = array.get(gaps, i)
        array.push(dist, close > g.top ? close - g.top : close < g.bot ? g.bot - close : 0.0)
    array<int> order = array.sort_indices(dist)
    for k = 0 to array.size(order) - 1
        f_styleGap(array.get(gaps, array.get(order, k)), k < maxDrawn)

// ---------------------------------------------------------- timeframes ---
f_mtf(string tf, int chartTrend) =>
    int sec = timeframe.in_seconds(tf)
    int chartSec = timeframe.in_seconds(timeframe.period)
    // Both requests run on every bar (structure needs its full history); the
    // timeframe comparison then picks the one that fits.
    // Higher timeframe: last closed bar only, so no repainting and no lookahead.
    int higher = request.security(syminfo.tickerid, tf, f_structure(swingLen)[1], lookahead = barmerge.lookahead_on)
    // Lower timeframe: its latest bar inside the current chart bar.
    int lower = request.security(syminfo.tickerid, tf, f_structure(swingLen))
    sec == chartSec ? chartTrend : sec > chartSec ? higher : lower

int t1 = f_mtf(tf1, trend)
int t2 = f_mtf(tf2, trend)
int t3 = f_mtf(tf3, trend)
int bullVotes = (t1 == 1 ? 1 : 0) + (t2 == 1 ? 1 : 0) + (t3 == 1 ? 1 : 0)
int bearVotes = (t1 == -1 ? 1 : 0) + (t2 == -1 ? 1 : 0) + (t3 == -1 ? 1 : 0)
bool htfLong  = htfFilter == "Off" ? true : htfFilter == "Timeframe 2" ? t2 == 1 : htfFilter == "Timeframe 3" ? t3 == 1 : bullVotes >= 2
bool htfShort = htfFilter == "Off" ? true : htfFilter == "Timeframe 2" ? t2 == -1 : htfFilter == "Timeframe 3" ? t3 == -1 : bearVotes >= 2

// ---------------------------------------------------- delta divergence ---
// Price makes a lower low but CVD makes a higher low: selling is being absorbed.
var float prevPlPrice = na
var float prevPlCvd = na
var int   prevPlDay = na
var int   bullDivBar = na
var float prevPhPrice = na
var float prevPhCvd = na
var int   prevPhDay = na
var int   bearDivBar = na
if not na(pl)
    float cvdAt = cvd[swingLen]
    int dayAt = dayIdx[swingLen]
    if not na(prevPlPrice) and dayAt == prevPlDay and pl < prevPlPrice and cvdAt > prevPlCvd
        bullDivBar := bar_index
    prevPlPrice := pl
    prevPlCvd := cvdAt
    prevPlDay := dayAt
if not na(ph)
    float cvdAtH = cvd[swingLen]
    int dayAtH = dayIdx[swingLen]
    if not na(prevPhPrice) and dayAtH == prevPhDay and ph > prevPhPrice and cvdAtH < prevPhCvd
        bearDivBar := bar_index
    prevPhPrice := ph
    prevPhCvd := cvdAtH
    prevPhDay := dayAtH
bool bullDiv = not na(bullDivBar) and bar_index - bullDivBar <= swingLen * 2
bool bearDiv = not na(bearDivBar) and bar_index - bearDivBar <= swingLen * 2

// ---------------------------------------------------------------- factors --
bool fStructL = trend == 1 and htfLong
bool fStructS = trend == -1 and htfShort
bool fZoneL   = supportTouched or supportTouched[1]
bool fZoneS   = resistTouched or resistTouched[1]
bool fReactL  = supportHeld or (fibLong and close > open and close > fib79)
bool fReactS  = resistHeld or (fibShort and close < open and close < fib79)
bool fFlowL   = ofScore > 0
bool fFlowS   = ofScore < 0
bool fDeltaL  = buyersDom and (cvdRising or bullDiv)
bool fDeltaS  = sellersDom and (cvdFalling or bearDiv)
bool fVol     = rvol >= minRvol
bool fSess    = inSess

int scoreL = (fStructL ? 1 : 0) + (fibLong ? 1 : 0) + (fZoneL ? 1 : 0) + (fReactL ? 1 : 0) + (fFlowL ? 1 : 0) + (fDeltaL ? 1 : 0) + (fVol ? 1 : 0) + (fSess ? 1 : 0)
int scoreS = (fStructS ? 1 : 0) + (fibShort ? 1 : 0) + (fZoneS ? 1 : 0) + (fReactS ? 1 : 0) + (fFlowS ? 1 : 0) + (fDeltaS ? 1 : 0) + (fVol ? 1 : 0) + (fSess ? 1 : 0)

// Stops sit beyond the reaction candle and the zone it came from.
float stopL = math.min(low, nz(heldZoneBot, low)) - stopAtr * atr
float stopS = math.max(high, nz(heldZoneTop, high)) + stopAtr * atr
float riskL = close - stopL
float riskS = stopS - close
bool riskOkL = riskL > mintickSafe and riskL <= maxRiskAtr * atr
bool riskOkS = riskS > mintickSafe and riskS <= maxRiskAtr * atr

bool setupL = fStructL and (fibLong or fZoneL) and fReactL and (fSess or not useSess) and scoreL >= minScore and riskOkL
bool setupS = fStructS and (fibShort or fZoneS) and fReactS and (fSess or not useSess) and scoreS >= minScore and riskOkS

// -------------------------------------------------- trades and exits -----
var int   pos = 0
var float entryPx = na
var float stopPx = na
var float riskPx = na
var float tp1Px = na
var float tp2Px = na
var bool  tp1Done = false
var int   entryBar = na
var int   nTrades = 0
var int   nWins = 0
var int   nLosses = 0
var float sumR = 0.0
var string lastExitWhy = ""
var float lastExitR = na
var line  lnStop = na
var line  lnTp1 = na
var line  lnTp2 = na

bool longSignal  = false
bool shortSignal = false
bool exitLong    = false
bool exitShort   = false
bool tp1Long     = false
bool tp1Short    = false
string exitWhy = ""
float exitPx = na

f_factorList(bool st, bool fb, bool zn, bool re, bool fl, bool de, bool vo, bool se) =>
    "Structure " + f_check(st) + "\nFib 79% " + f_check(fb) + "\nFVG/IFVG " + f_check(zn) + "\nRespected " + f_check(re) + "\nOrder flow " + f_check(fl) + "\nDelta " + f_check(de) + "\nVolume " + f_check(vo) + "\nSession " + f_check(se)

if barstate.isconfirmed
    bool flatAtStart = pos == 0
    if pos == 1 and bar_index > entryBar
        if low <= stopPx
            exitLong := true
            exitPx := math.min(stopPx, open)
            exitWhy := tp1Done and beAfterTp1 ? "Breakeven stop" : "Stop"
        else if high >= tp2Px
            exitLong := true
            exitPx := math.max(tp2Px, open)
            exitWhy := "Target 2"
        else
            if not tp1Done and high >= tp1Px
                tp1Done := true
                tp1Long := true
                if beAfterTp1
                    stopPx := entryPx
                    line.set_y1(lnStop, entryPx)
                    line.set_y2(lnStop, entryPx)
            if exitOnFlip and bearBreak
                exitLong := true
                exitPx := close
                exitWhy := "Structure flipped"
            else if exitOnOf and supportBroken
                exitLong := true
                exitPx := close
                exitWhy := "Order flow disrespected"
    else if pos == -1 and bar_index > entryBar
        if high >= stopPx
            exitShort := true
            exitPx := math.max(stopPx, open)
            exitWhy := tp1Done and beAfterTp1 ? "Breakeven stop" : "Stop"
        else if low <= tp2Px
            exitShort := true
            exitPx := math.min(tp2Px, open)
            exitWhy := "Target 2"
        else
            if not tp1Done and low <= tp1Px
                tp1Done := true
                tp1Short := true
                if beAfterTp1
                    stopPx := entryPx
                    line.set_y1(lnStop, entryPx)
                    line.set_y2(lnStop, entryPx)
            if exitOnFlip and bullBreak
                exitShort := true
                exitPx := close
                exitWhy := "Structure flipped"
            else if exitOnOf and resistBroken
                exitShort := true
                exitPx := close
                exitWhy := "Order flow disrespected"

    if exitLong or exitShort
        float r = exitLong ? (exitPx - entryPx) / riskPx : (entryPx - exitPx) / riskPx
        nTrades += 1
        sumR += r
        if r > 0.05
            nWins += 1
        else if r < -0.05
            nLosses += 1
        lastExitWhy := exitWhy
        lastExitR := r
        string txt = (exitLong ? "SELL" : "COVER") + "\n" + exitWhy + " " + f_signed(r, "#.##") + "R"
        label.new(bar_index, exitLong ? high : low, txt, style = exitLong ? label.style_label_down : label.style_label_up, color = r >= 0 ? color.new(cBull, 15) : color.new(cBear, 15), textcolor = color.white, size = size.tiny)
        line.set_x2(lnStop, bar_index)
        line.set_x2(lnTp1, bar_index)
        line.set_x2(lnTp2, bar_index)
        line.set_extend(lnStop, extend.none)
        line.set_extend(lnTp1, extend.none)
        line.set_extend(lnTp2, extend.none)
        pos := 0

    if tp1Long or tp1Short
        label.new(bar_index, tp1Long ? high : low, "TP1", style = tp1Long ? label.style_label_down : label.style_label_up, color = color.new(cBull, 40), textcolor = color.white, size = size.tiny)

    if flatAtStart and setupL
        longSignal := true
    else if flatAtStart and setupS
        shortSignal := true

    if longSignal or shortSignal
        pos := longSignal ? 1 : -1
        entryPx := close
        stopPx := longSignal ? stopL : stopS
        riskPx := longSignal ? riskL : riskS
        tp1Px := longSignal ? close + tp1R * riskPx : close - tp1R * riskPx
        tp2Px := longSignal ? close + tp2R * riskPx : close - tp2R * riskPx
        tp1Done := false
        entryBar := bar_index
        string tip = f_factorList(longSignal ? fStructL : fStructS, longSignal ? fibLong : fibShort, longSignal ? fZoneL : fZoneS, longSignal ? fReactL : fReactS, longSignal ? fFlowL : fFlowS, longSignal ? fDeltaL : fDeltaS, fVol, fSess)
        string sig = (longSignal ? "LONG " : "SHORT ") + f_px(entryPx) + "\nscore " + str.tostring(longSignal ? scoreL : scoreS) + "/8"
        label.new(bar_index, longSignal ? low : high, sig, style = longSignal ? label.style_label_up : label.style_label_down, color = longSignal ? cBull : cBear, textcolor = color.white, size = size.small, tooltip = tip)
        lnStop := line.new(bar_index, stopPx, bar_index + 1, stopPx, color = cBear, style = line.style_dotted, extend = extend.right)
        lnTp1 := line.new(bar_index, tp1Px, bar_index + 1, tp1Px, color = color.new(cBull, 40), style = line.style_dotted, extend = extend.right)
        lnTp2 := line.new(bar_index, tp2Px, bar_index + 1, tp2Px, color = cBull, style = line.style_dotted, extend = extend.right)

// ============================================================ strategies ==
// Ten separate playbooks. Each one takes its own virtual trades on candle
// close, independent of the ICT signals above, and keeps its own record.

type Strat
    string code
    string name
    int    dir = 0
    float  entry
    float  stop
    float  tp1
    float  tp2
    bool   hitTp1 = false
    bool   beOnTp1 = false
    int    bar
    int    maxBars = 0
    float  risk
    int    n = 0
    int    wins = 0
    float  totR = 0.0
    string lastWhy = ""
    float  lastR
    string unit = "R"

var Strat sBO = Strat.new("BO", "Breakout")
var Strat sPB = Strat.new("PB", "Pullback")
var Strat sRG = Strat.new("RG", "Range")
var Strat sMR = Strat.new("MR", "Mean reversion")
var Strat sNW = Strat.new("NEWS", "News")
var Strat sSP = Strat.new(code = "SPR", name = "Spread", unit = "%")
var Strat sSC = Strat.new("SC", "Scalping")
var Strat sOF = Strat.new("OF", "Order flow")
var Strat sGX = Strat.new("GEX", "GEX + order flow")
var Strat sGA = Strat.new("GAV", "GEX + AVWAP")

f_open(Strat s, int dir, float sl, float tp1, float tp2, bool be, int maxBars, string tip) =>
    s.dir := dir
    s.entry := close
    s.stop := sl
    s.risk := math.abs(close - sl)
    s.tp1 := tp1
    s.tp2 := tp2
    s.hitTp1 := false
    s.beOnTp1 := be
    s.bar := bar_index
    s.maxBars := maxBars
    float tgt = na(tp2) ? tp1 : tp2
    string side = dir == 1 ? " LONG " : " SHORT "
    if stratLabels
        label.new(bar_index, dir == 1 ? low : high, (dir == 1 ? "▲ " : "▼ ") + s.code, style = dir == 1 ? label.style_label_up : label.style_label_down, color = color.new(dir == 1 ? cBull : cBear, 35), textcolor = color.white, size = size.tiny, tooltip = s.name + side + f_px(close) + "\nStop " + f_px(sl) + "\nTarget " + f_px(tgt) + (tip == "" ? "" : "\n" + tip))
    alert(s.name + side + syminfo.ticker + " " + f_tf(timeframe.period) + " @ " + f_px(close) + " | stop " + f_px(sl) + " | target " + f_px(tgt), alert.freq_once_per_bar_close)
    s.dir

f_close(Strat s, float px, string why) =>
    float r = s.risk > 0 ? (px - s.entry) * s.dir / s.risk : 0.0
    s.n := s.n + 1
    s.totR := s.totR + r
    if r > 0.05
        s.wins := s.wins + 1
    s.lastWhy := why
    s.lastR := r
    if stratLabels
        label.new(bar_index, s.dir == 1 ? high : low, s.code + " " + f_signed(r, "#.#") + s.unit, style = s.dir == 1 ? label.style_label_down : label.style_label_up, color = color.new(r >= 0 ? cBull : cBear, 60), textcolor = color.white, size = size.tiny, tooltip = s.name + " exit: " + why)
    alert(s.name + (s.dir == 1 ? " exit long " : " exit short ") + syminfo.ticker + " " + f_tf(timeframe.period) + " | " + why + " " + f_signed(r, "#.##") + s.unit, alert.freq_once_per_bar_close)
    s.dir := 0
    r

// Stop first (the cautious assumption when one candle hits both), then target, then the strategy's own exit.
f_manage(Strat s, bool exitNow, string whyNow) =>
    float tgt = na(s.tp2) ? s.tp1 : s.tp2
    if s.dir == 1 and bar_index > s.bar
        if low <= s.stop
            f_close(s, math.min(s.stop, open), s.hitTp1 and s.beOnTp1 ? "Breakeven stop" : "Stop")
        else if high >= tgt
            f_close(s, math.max(tgt, open), "Target")
        else
            if not na(s.tp2) and not s.hitTp1 and high >= s.tp1
                s.hitTp1 := true
                if s.beOnTp1
                    s.stop := s.entry
            if exitNow
                f_close(s, close, whyNow)
            else if s.maxBars > 0 and bar_index - s.bar >= s.maxBars
                f_close(s, close, "Time stop")
    else if s.dir == -1 and bar_index > s.bar
        if high >= s.stop
            f_close(s, math.max(s.stop, open), s.hitTp1 and s.beOnTp1 ? "Breakeven stop" : "Stop")
        else if low <= tgt
            f_close(s, math.min(tgt, open), "Target")
        else
            if not na(s.tp2) and not s.hitTp1 and low <= s.tp1
                s.hitTp1 := true
                if s.beOnTp1
                    s.stop := s.entry
            if exitNow
                f_close(s, close, whyNow)
            else if s.maxBars > 0 and bar_index - s.bar >= s.maxBars
                f_close(s, close, "Time stop")
    s.dir

// Nearest level at least minRR away in the trade's direction, else 2R.
f_target(int dir, float entry, float risk, float a, float b, float c) =>
    float best = na
    array<float> lv = array.from(a, b, c)
    for lvl in lv
        if not na(lvl) and (lvl - entry) * dir >= minRR * risk
            if na(best) or math.abs(lvl - entry) < math.abs(best - entry)
                best := lvl
    na(best) ? entry + dir * 2.0 * risk : best

// Separate visits to a level over the last len bars, oldest first.
f_touches(float lvl, float tol, int len, bool top) =>
    int cnt = 0
    bool prevNear = false
    for i = len to 1
        bool near = top ? high[i] >= lvl - tol : low[i] <= lvl + tol
        if near and not prevNear
            cnt += 1
        prevNear := near
    cnt

f_hhmm(int m) =>
    int h = math.floor(m / 60)
    int mm = m % 60
    str.tostring(h) + ":" + (mm < 10 ? "0" : "") + str.tostring(mm)

// Shared readings.
float ema9   = ta.ema(close, 9)
float ema21  = ta.ema(close, 21)
float pbFast = ta.ema(close, pbFastLen)
float pbSlow = ta.ema(close, pbSlowLen)
float rsi14  = ta.rsi(close, 14)
[bbMid, bbUp, bbLo] = ta.bb(close, bbLen, bbMult)
[diPlus, diMinus, adxV] = ta.dmi(14, 14)
float vwapV  = ta.vwap(hlc3)
float hi3    = ta.highest(high, 3)
float lo3    = ta.lowest(low, 3)
float hi5    = ta.highest(high, 5)
float lo5    = ta.lowest(low, 5)
float hi20   = ta.highest(high, 20)
float lo20   = ta.lowest(low, 20)
float rsiHi3 = ta.highest(rsi14, 3)
float rsiLo3 = ta.lowest(rsi14, 3)
// Price makes a new 10-bar extreme but RSI doesn't.
float lo10    = ta.lowest(low, 10)[1]
float hi10    = ta.highest(high, 10)[1]
float rsiLo10 = ta.lowest(rsi14, 10)[1]
float rsiHi10 = ta.highest(rsi14, 10)[1]
bool rsiBullDiv = low < lo10 and rsi14 > rsiLo10
bool rsiBearDiv = high > hi10 and rsi14 < rsiHi10
bool sOk = inSess or not useSess

// Reversal candles: engulfing bars and pin bars.
float cBody   = math.abs(close - open)
float cRange  = high - low
float lowWick = math.min(open, close) - low
float upWick  = high - math.max(open, close)
bool bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bool bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
bool bullPin = cRange > 0 and lowWick >= 0.5 * cRange and cBody <= 0.4 * cRange and close >= low + 0.6 * cRange
bool bearPin = cRange > 0 and upWick >= 0.5 * cRange and cBody <= 0.4 * cRange and close <= high - 0.6 * cRange
bool bullRev = bullEngulf or bullPin
bool bearRev = bearEngulf or bearPin

// 1. Breakout: a close outside a tight range on strong volume.
float boHi = ta.highest(high, boLen)[1]
float boLo = ta.lowest(low, boLen)[1]
float boH  = boHi - boLo
bool  boTight = boH <= boMaxAtr * atr[1]
bool  boLong  = boTight and close > boHi and rvol >= boVolMult
bool  boShort = boTight and close < boLo and rvol >= boVolMult
float boHiNow = ta.highest(high, boLen)
float boLoNow = ta.lowest(low, boLen)
bool  boTightNow = boHiNow - boLoNow <= boMaxAtr * atr

// 2. Pullback: a reversal candle at the fast EMA, the 38-62% zone, or old resistance turned support.
var float flipUp = na
var float flipDn = na
if bullBreak
    flipUp := swingHigh
if bearBreak
    flipDn := swingLow
bool  pbUp  = trend == 1 and close > pbSlow and pbFast > pbSlow
bool  pbDn  = trend == -1 and close < pbSlow and pbFast < pbSlow
float pb382 = legDir == 1 ? legHigh - 0.382 * legRange : legDir == -1 ? legLow + 0.382 * legRange : na
float pb618 = legDir == 1 ? legHigh - 0.618 * legRange : legDir == -1 ? legLow + 0.618 * legRange : na
bool  pbZoneL = low <= pbFast or (legDir == 1 and low <= pb382 and low >= pb618 - fibTol) or (not na(flipUp) and low <= flipUp + 0.2 * atr and low >= flipUp - 0.5 * atr)
bool  pbZoneS = high >= pbFast or (legDir == -1 and high >= pb382 and high <= pb618 + fibTol) or (not na(flipDn) and high >= flipDn - 0.2 * atr and high <= flipDn + 0.5 * atr)
bool  pbLong  = pbUp and pbZoneL and bullRev
bool  pbShort = pbDn and pbZoneS and bearRev

// 3. Range: two or more touches of each side, a weak ADX, and a reversal at an edge.
float rgHi  = ta.highest(high, rgLen)[1]
float rgLo  = ta.lowest(low, rgLen)[1]
float rgH   = rgHi - rgLo
float rgMid = (rgHi + rgLo) / 2
int   rgTopN = f_touches(rgHi, 0.1 * rgH, rgLen, true)
int   rgBotN = f_touches(rgLo, 0.1 * rgH, rgLen, false)
bool  rgOk    = rgTopN >= rgTouch and rgBotN >= rgTouch and adxV < rgAdxMax and rgH >= 1.5 * atr
bool  rgLong  = rgOk and low <= rgLo + 0.2 * rgH and close > rgLo and close < rgMid and (bullRev or (rsiBullDiv and close > open))
bool  rgShort = rgOk and high >= rgHi - 0.2 * rgH and close < rgHi and close > rgMid and (bearRev or (rsiBearDiv and close < open))

// 4. Mean reversion: a push outside the Bollinger band with RSI stretched, then a close back inside.
float mrMean  = mrTarget == "VWAP" ? vwapV : bbMid
bool  mrPushL = close[1] < bbLo[1] or (low < bbLo and close > bbLo)
bool  mrPushS = close[1] > bbUp[1] or (high > bbUp and close < bbUp)
bool  mrLong  = mrPushL and close > bbLo and close > open and rsiLo3 <= rsiLo and (not mrNeedDiv or rsiBullDiv or rsiBullDiv[1])
bool  mrShort = mrPushS and close < bbUp and close < open and rsiHi3 >= rsiHi and (not mrNeedDiv or rsiBearDiv or rsiBearDiv[1])

// 5. News: TradingView has no economic calendar, so this watches the usual release
// times. If a real move starts there, it waits out the whipsaw and buys or sells the
// first pullback in the direction of the move.
var array<int> nwMins = array.new<int>()
if barstate.isfirst
    array<string> parts = str.split(str.replace_all(nwTimes, " ", ""), ",")
    for p in parts
        float hm = str.tonumber(p)
        if not na(hm)
            array.push(nwMins, int(math.floor(hm / 100)) * 60 + int(hm % 100))
int  barMin    = int(timeframe.in_seconds() / 60)
int  nyMins    = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
int  nyDow     = dayofweek(time, "America/New_York")
bool nyWeekday = nyDow != dayofweek.saturday and nyDow != dayofweek.sunday
int  nwWaitBars = math.max(1, int(math.ceil(nwWaitMin / math.max(barMin, 1))))
int  nwWinBars  = math.max(2, int(math.ceil(60 / math.max(barMin, 1))))
int  nwPreBars  = math.max(1, int(math.ceil(15 / math.max(barMin, 1))))
float nwPreHi = ta.highest(high, nwPreBars)
float nwPreLo = ta.lowest(low, nwPreBars)
string nwHit = ""
if timeframe.isintraday and nyWeekday and array.size(nwMins) > 0
    for e in nwMins
        if nyMins <= e and e < nyMins + barMin
            nwHit := f_hhmm(e)

var int    nwState = 0      // 0 idle, 1 waiting out the release, 2 looking for the pullback
var int    nwDir = 0
var float  nwHi = na
var float  nwLo = na
var float  nwPre = na
var int    nwStart = na
var int    nwArmed = na
var bool   nwRetr = false
var string nwName = ""
if nwHit != ""
    nwState := 1
    nwStart := bar_index
    nwPre := close[1]
    nwHi := high
    nwLo := low
    nwName := nwHit
    nwDir := 0
    nwRetr := false
else if nwState == 1
    nwHi := math.max(nwHi, high)
    nwLo := math.min(nwLo, low)
if nwState == 1 and bar_index - nwStart + 1 >= nwWaitBars
    float mv = close - nwPre
    if math.abs(mv) >= atr and nwHi - nwLo >= nwSpikeAtr * atr
        nwState := 2
        nwDir := mv > 0 ? 1 : -1
        nwArmed := bar_index
    else
        nwState := 0
else if nwState == 2
    if bar_index - nwArmed > nwWinBars
        nwState := 0
    else if nwDir == 1
        if not nwRetr and high > nwHi
            nwHi := high
        if low <= nwHi - 0.3 * (nwHi - nwLo)
            nwRetr := true
        if close < nwLo
            nwState := 0
    else
        if not nwRetr and low < nwLo
            nwLo := low
        if high >= nwLo + 0.3 * (nwHi - nwLo)
            nwRetr := true
        if close > nwHi
            nwState := 0
bool nwLong  = nwState == 2 and nwDir == 1 and nwRetr and bar_index > nwArmed and close > open and close > (nwHi + nwLo) / 2
bool nwShort = nwState == 2 and nwDir == -1 and nwRetr and bar_index > nwArmed and close < open and close < (nwHi + nwLo) / 2

// 6. Spread: this chart against a correlated market (NQ vs ES, gold vs silver).
// The z-score of their price ratio says when the gap between them is unusually wide.
string spRoot   = syminfo.root
string spAuto   = spRoot == "NQ" or spRoot == "MNQ" ? "ES" : spRoot == "ES" or spRoot == "MES" ? "NQ" : spRoot == "GC" or spRoot == "MGC" ? "SI" : ""
string spTicker = spSymIn != "Auto" and spSymIn != "" ? spSymIn : spAuto == "" ? "" : syminfo.prefix + ":" + spAuto + "1!"
string spName   = array.last(str.split("x:" + spTicker, ":"))
float  spRaw    = request.security(spTicker == "" ? syminfo.tickerid : spTicker, timeframe.period, close, ignore_invalid_symbol = true)
float  pairC    = spTicker == "" ? na : spRaw
float  spRatio  = na(pairC) or pairC == 0 ? na : close / pairC
float  spMean   = ta.sma(spRatio, spLen)
float  spSd     = ta.stdev(spRatio, spLen)
float  spZ      = spSd > 0 ? (spRatio - spMean) / spSd : na
float  spCorr   = ta.correlation(close / close[1] - 1, pairC / pairC[1] - 1, spLen)
bool   spReady  = not na(spZ) and not na(spCorr) and spCorr >= spMinCorr
bool   spLong   = spReady and spZ <= -spEntryZ and spZ[1] > -spEntryZ
bool   spShort  = spReady and spZ >= spEntryZ and spZ[1] < spEntryZ

// 7. Scalping (1-5 minute charts): EMA 9/21 momentum and a break of the last micro swing.
bool  scOk = timeframe.isintraday and timeframe.in_seconds() <= 300
float mph  = ta.pivothigh(high, 2, 2)
float mpl  = ta.pivotlow(low, 2, 2)
var float mHi = na
var float mLo = na
var bool  mHiUsed = true
var bool  mLoUsed = true
if not na(mph)
    mHi := mph
    mHiUsed := false
if not na(mpl)
    mLo := mpl
    mLoUsed := false
bool scLong  = scOk and ema9 > ema21 and not mHiUsed and close > mHi
bool scShort = scOk and ema9 < ema21 and not mLoUsed and close < mLo
if close > mHi
    mHiUsed := true
if close < mLo
    mLoUsed := true

// 8. Order flow: absorption. Heavy one-sided delta on high volume at a key level
// while price refuses to follow, then a close back through the bar.
// Session volume profile from the 1-minute intrabars, for the point of control.
var map<int, float> vp = map.new<int, float>()
var float vpBin = na
var int   pocBin = na
var float pocVol = 0.0
var float prevPoc = na
float binNow = na(atr) ? mintickSafe * 20 : math.max(mintickSafe, math.round(atr * 0.5 / mintickSafe) * mintickSafe)
if newDay
    if not na(pocBin)
        prevPoc := (pocBin + 0.5) * vpBin
    map.clear(vp)
    pocBin := na
    pocVol := 0.0
    vpBin := binNow
if na(vpBin)
    vpBin := binNow
if nIntra > 0
    for i = 0 to nIntra - 1
        float vc = array.get(ltfC, i)
        if not na(vc)
            int   vb = math.floor(vc / vpBin)
            float nv = nz(map.get(vp, vb)) + nz(array.get(ltfV, i))
            map.put(vp, vb, nv)
            if nv > pocVol
                pocVol := nv
                pocBin := vb
else
    int   vb0 = math.floor(hlc3 / vpBin)
    float nv0 = nz(map.get(vp, vb0)) + nz(volume)
    map.put(vp, vb0, nv0)
    if nv0 > pocVol
        pocVol := nv0
        pocBin := vb0
float poc = na(pocBin) ? na : (pocBin + 0.5) * vpBin

var float sHi = na
var float sLo = na
float sHiPrev = newDay ? na : sHi
float sLoPrev = newDay ? na : sLo
if newDay or na(sHi)
    sHi := high
    sLo := low
else
    sHi := math.max(sHi, high)
    sLo := math.min(sLo, low)

float kTol   = 0.25 * atr
float barRng = high - low
bool  keyLow  = (not na(sLoPrev) and low <= sLoPrev + kTol) or (not na(prevPoc) and math.abs(low - prevPoc) <= kTol) or math.abs(low - vwapV) <= kTol or supportTouched
bool  keyHigh = (not na(sHiPrev) and high >= sHiPrev - kTol) or (not na(prevPoc) and math.abs(high - prevPoc) <= kTol) or math.abs(high - vwapV) <= kTol or resistTouched
bool  absBull = keyLow and rvol >= ofAbsRvol and deltaPct <= -ofAbsDelta / 100.0 and barRng > 0 and close >= low + 0.5 * barRng
bool  absBear = keyHigh and rvol >= ofAbsRvol and deltaPct >= ofAbsDelta / 100.0 and barRng > 0 and close <= high - 0.5 * barRng
var int   abDir = 0
var float abHi = na
var float abLo = na
var int   abBar = na
if absBull
    abDir := 1
    abHi := high
    abLo := low
    abBar := bar_index
else if absBear
    abDir := -1
    abHi := high
    abLo := low
    abBar := bar_index
else if abDir != 0
    if bar_index - abBar > 3 or (abDir == 1 and low < abLo) or (abDir == -1 and high > abHi)
        abDir := 0
bool ofLong  = abDir == 1 and bar_index > abBar and close > abHi
bool ofShort = abDir == -1 and bar_index > abBar and close < abLo

// Flow score, after SuperFlow (profitnotiondaily/atasx-superflow): absorption, delta
// z-score, big prints, effort vs result, CVD slope, rolling CVD and volume, weighted
// as SuperFlow weights them, from -1 (sellers in control) to +1 (buyers). Its
// footprint-only parts (stacked imbalances, big resting orders) aren't in Pine.
float sfVD      = math.max(-1, math.min(1, deltaZ / 3))
float cvdEma    = ta.ema(delta, 6)
float cvdEmaMax = math.max(ta.highest(math.abs(cvdEma), 20), 1e-10)
float sfCvdS0   = math.max(-1, math.min(1, cvdEma / cvdEmaMax))
bool  sfDiv     = (close > close[1] and sfCvdS0 < -0.1) or (close < close[1] and sfCvdS0 > 0.1)
float sfCvdS    = sfDiv ? math.max(-1, math.min(1, sfCvdS0 + (close > close[1] ? -0.3 : 0.3))) : sfCvdS0
f_roll(int p) =>
    float v = math.sum(volume, p)
    v > 0 ? math.max(-1, math.min(1, math.sum(delta, p) / v / 0.2)) : 0.0
float sfR1    = f_roll(5)
float sfR2    = f_roll(10)
float sfR3    = f_roll(20)
bool  sfAgree = (sfR1 > 0 and sfR2 > 0 and sfR3 > 0) or (sfR1 < 0 and sfR2 < 0 and sfR3 < 0)
float sfCvdR  = math.max(-1, math.min(1, (sfR1 + sfR2 + sfR3) / 3 * (sfAgree ? 1.5 : 1.0)))
float sfAbs   = absBull ? 1.0 : absBear ? -1.0 : 0.0
float erVal   = volume / math.max((high - low) / mintickSafe, 0.5)
float erAvg   = ta.sma(erVal, 20)
float erRatio = erAvg > 0 ? erVal / erAvg : 1.0
float sfER    = erRatio > 1.5 ? (close >= open ? -1 : 1) * math.min(1, (erRatio - 1) / 2) : erRatio < 0.67 ? (close >= open ? 1 : -1) * math.min(1, (1 - erRatio) * 1.5) : 0.0
float sfVol   = math.max(-1, math.min(1, rvol - 1)) * (delta >= 0 ? 1 : -1)
float sfBT    = btN > 0 ? math.max(-1, math.min(1, btSum / btN)) : 0.0
float flowScore = rvol < 0.5 ? 0.0 : math.max(-1, math.min(1, (0.15 * sfAbs + 0.15 * sfVD + 0.10 * sfBT + 0.10 * sfER + 0.08 * sfCvdS + 0.07 * sfCvdR + 0.05 * sfVol) / 0.70))

// 9. GEX: dealer gamma levels from CBOE option chains (gex/gex_levels.py runs on
// GitHub every weekday morning). Pine can't download them, so the lines of
// gex/latest.txt are pasted into the settings. They come in the options' own prices
// (SPX, NDX, GLD...) and are moved onto the futures with the futures/underlying
// ratio from regular-hours bars. Each snapshot applies from its time stamp on.
// vk / vc / vp: today's busiest strikes by option volume (calls, puts), the
// options-flow levels. Older snapshots in history.txt don't keep them.
type GexSnap
    int    ts
    float  spot
    float  flip
    float  cw
    float  pw
    float  total
    array<float> ks
    array<float> gs
    array<float> vk
    array<float> vc
    array<float> vp

f_gnum(string s) =>
    s == "na" or s == "" ? na : str.tonumber(str.replace_all(s, "+", ""))

// Index of the options-flow strike at k (within 0.1%), or -1.
f_flowAt(GexSnap s, float k) =>
    int out = -1
    if not na(s)
        for [i, v] in s.vk
            if math.abs(v - k) <= 0.001 * k and (out < 0 or math.abs(v - k) < math.abs(array.get(s.vk, out) - k))
                out := i
    out

string gxRoot    = syminfo.root
string gexAuto   = gxRoot == "NQ" or gxRoot == "MNQ" ? "NDX" : gxRoot == "ES" or gxRoot == "MES" ? "SPX" : gxRoot == "RTY" or gxRoot == "M2K" ? "RUT" : gxRoot == "YM" or gxRoot == "MYM" ? "DIA" : gxRoot == "GC" or gxRoot == "MGC" ? "GLD" : gxRoot == "SI" or gxRoot == "SIL" or gxRoot == "SIC" ? "SLV" : gxRoot == "CL" or gxRoot == "MCL" or gxRoot == "QM" ? "USO" : gxRoot == "NG" or gxRoot == "QG" or gxRoot == "MNG" ? "UNG" : gxRoot == "ZB" or gxRoot == "UB" ? "TLT" : ""
string gexName   = gexUnd == "Auto" ? gexAuto : gexUnd
string gexTicker = gexName == "SPX" ? "SP:SPX" : gexName == "SPY" ? "AMEX:SPY" : gexName == "NDX" ? "NASDAQ:NDX" : gexName == "QQQ" ? "NASDAQ:QQQ" : gexName == "RUT" ? "TVC:RUT" : gexName == "IWM" ? "AMEX:IWM" : gexName == "DIA" ? "AMEX:DIA" : gexName == "GLD" ? "AMEX:GLD" : gexName == "SLV" ? "AMEX:SLV" : gexName == "USO" ? "AMEX:USO" : gexName == "UNG" ? "AMEX:UNG" : gexName == "TLT" ? "NASDAQ:TLT" : ""

// Kronos forecasts (forecast/kronos_forecast.py) ride in the same file as FC:<market>
// lines, in futures prices: the newest one for this market is kept.
string fcName = gxRoot == "NQ" or gxRoot == "MNQ" ? "FC:NQ" : gxRoot == "ES" or gxRoot == "MES" ? "FC:ES" : gxRoot == "RTY" or gxRoot == "M2K" ? "FC:RTY" : gxRoot == "YM" or gxRoot == "MYM" ? "FC:YM" : gxRoot == "GC" or gxRoot == "MGC" ? "FC:GC" : ""
var int    fcTs   = na
var float  fcLast = na
var float  fc1h   = na
var float  fc2h   = na
var float  fcHi   = na
var float  fcLo   = na
var string fcHit  = ""

var array<GexSnap> gexSnaps = array.new<GexSnap>()
if barstate.isfirst and (gexName != "" or fcName != "")
    array<string> gexRows = str.split(gexText, "\n")
    for gl in gexRows
        array<string> tk = str.split(gl, " ")
        bool isGex = array.size(tk) >= 3 and gexName != "" and array.get(tk, 1) == gexName
        bool isFc  = array.size(tk) >= 3 and fcName != "" and array.get(tk, 1) == fcName
        if (isGex or isFc) and str.length(array.get(tk, 0)) >= 10
            string st = array.get(tk, 0)
            int yy = int(str.tonumber(str.substring(st, 0, 4)))
            int mo = int(str.tonumber(str.substring(st, 5, 7)))
            int dd = int(str.tonumber(str.substring(st, 8, 10)))
            int hh = str.length(st) >= 16 ? int(str.tonumber(str.substring(st, 11, 13))) : 9
            int mi = str.length(st) >= 16 ? int(str.tonumber(str.substring(st, 14, 16))) : 0
            int lts = na(yy) or na(mo) or na(dd) ? na : timestamp("America/New_York", yy, mo, dd, nz(hh, 9), nz(mi, 0))
            if isFc and not na(lts) and (na(fcTs) or lts >= fcTs)
                fcTs := lts
                for i = 2 to array.size(tk) - 1
                    array<string> kv = str.split(array.get(tk, i), "=")
                    if array.size(kv) == 2
                        string key = array.get(kv, 0)
                        string val = array.get(kv, 1)
                        if key == "last"
                            fcLast := f_gnum(val)
                        else if key == "c1h"
                            fc1h := f_gnum(val)
                        else if key == "c2h"
                            fc2h := f_gnum(val)
                        else if key == "hi"
                            fcHi := f_gnum(val)
                        else if key == "lo"
                            fcLo := f_gnum(val)
                        else if key == "hit"
                            fcHit := val
            if isGex and not na(lts)
                GexSnap snap = GexSnap.new(lts, na, na, na, na, na, array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>())
                for i = 2 to array.size(tk) - 1
                    array<string> kv = str.split(array.get(tk, i), "=")
                    if array.size(kv) == 2
                        string key = array.get(kv, 0)
                        string val = array.get(kv, 1)
                        if key == "spot"
                            snap.spot := f_gnum(val)
                        else if key == "flip"
                            snap.flip := f_gnum(val)
                        else if key == "cw"
                            snap.cw := f_gnum(val)
                        else if key == "pw"
                            snap.pw := f_gnum(val)
                        else if key == "total"
                            snap.total := f_gnum(val)
                        else if key == "k"
                            array<string> pairs = str.split(val, ",")
                            for pr in pairs
                                array<string> kg = str.split(pr, ":")
                                if array.size(kg) == 2
                                    float kk = f_gnum(array.get(kg, 0))
                                    float gg = f_gnum(array.get(kg, 1))
                                    if not na(kk) and not na(gg)
                                        array.push(snap.ks, kk)
                                        array.push(snap.gs, gg)
                        else if key == "v"
                            array<string> vpairs = str.split(val, ",")
                            for pr in vpairs
                                array<string> kc = str.split(pr, ":")
                                if array.size(kc) == 2
                                    array<string> cp = str.split(array.get(kc, 1), "/")
                                    float kk = f_gnum(array.get(kc, 0))
                                    if array.size(cp) == 2 and not na(kk)
                                        array.push(snap.vk, kk)
                                        array.push(snap.vc, nz(f_gnum(array.get(cp, 0))))
                                        array.push(snap.vp, nz(f_gnum(array.get(cp, 1))))
                int at = array.size(gexSnaps)
                while at > 0 and array.get(gexSnaps, at - 1).ts > snap.ts
                    at -= 1
                array.insert(gexSnaps, at, snap)

// The chart's price when the forecast was made: Kronos's moves are added to it.
var float fcAt = na
if not na(fcTs) and time <= fcTs
    fcAt := close

// Futures/underlying ratio, from regular-hours bars when both trade, smoothed.
float gexUndC = request.security(gexTicker == "" ? syminfo.tickerid : gexTicker, timeframe.period, close, ignore_invalid_symbol = true)
bool  inRth   = not na(time(timeframe.period, "0930-1600", "America/New_York"))
var float gexRatio = na
if gexTicker != "" and timeframe.isintraday and inRth and gexUndC > 0
    float rNow = close / gexUndC
    gexRatio := na(gexRatio) ? rNow : gexRatio + 0.1 * (rNow - gexRatio)

var int gexIdx = -1
while gexIdx + 1 < array.size(gexSnaps) and array.get(gexSnaps, gexIdx + 1).ts <= time
    gexIdx += 1
// Lines start at the day's first snapshot, so intraday refreshes don't shorten them.
var int gexSeen = -1
var int gexStartBar = na
var int gexDayKey = na

// Each strong strike (the walls and the 8 biggest) gets a status for the day, set
// further down: 1 held, -1 broke.
var map<int, int> lvStat  = map.new<int, int>()
var map<int, int> lvTouch = map.new<int, int>()
var int lvHeldN  = 0
var int lvBrokeN = 0
var int lvDay    = na
int nyDay = year(time, "America/New_York") * 10000 + month(time, "America/New_York") * 100 + dayofmonth(time, "America/New_York")
if nyDay != lvDay
    lvDay := nyDay
    map.clear(lvStat)
    map.clear(lvTouch)

// Which levels count. Trusted only: the walls and the flip, plus a big strike only
// where today's option volume is heavy too, and nothing once it broke today. The ETF
// stand-ins (gold, silver, crude, gas, bonds) get just the walls and the flip.
bool gxTrusted = gexMode == "Trusted only"
bool gxProxy   = gexName == "GLD" or gexName == "SLV" or gexName == "USO" or gexName == "UNG" or gexName == "TLT"
f_topK(GexSnap s) =>
    array<float> out = array.new<float>()
    if array.size(s.gs) > 0
        array<float> ab = array.new<float>()
        for g in s.gs
            array.push(ab, math.abs(g))
        array<int> od = array.sort_indices(ab, order.descending)
        for j = 0 to math.min(8, array.size(od)) - 1
            array.push(out, array.get(s.ks, array.get(od, j)))
    out
f_trustK(GexSnap s, array<float> top) =>
    array<float> out = array.new<float>()
    if not (gxTrusted and gxProxy)
        for k in top
            if not gxTrusted or f_flowAt(s, k) >= 0
                array.push(out, k)
    out
f_broke(float k) =>
    nz(map.get(lvStat, int(math.round(k * 100)))) == -1
// The levels in futures prices: the flip, the walls and the given strikes.
f_lvls(GexSnap s, array<float> ks) =>
    array<float> out = array.new<float>()
    if not na(s.flip)
        array.push(out, s.flip * gexRatio)
    array<float> cand = array.copy(ks)
    if not na(s.cw)
        array.push(cand, s.cw)
    if not na(s.pw)
        array.push(cand, s.pw)
    for k in cand
        if not (gxTrusted and f_broke(k))
            array.push(out, k * gexRatio)
    out

// gxTopK: each snapshot's 8 biggest strikes (their status is tracked); gxSigK: the ones
// the signals use.
var array<float> gxTopK = array.new<float>()
var array<float> gxSigK = array.new<float>()
if gexIdx != gexSeen
    gexSeen := gexIdx
    if gexIdx >= 0
        GexSnap gs0 = array.get(gexSnaps, gexIdx)
        int gts = gs0.ts
        int dk = year(gts, "America/New_York") * 10000 + month(gts, "America/New_York") * 100 + dayofmonth(gts, "America/New_York")
        if na(gexDayKey) or dk != gexDayKey
            gexDayKey := dk
            gexStartBar := bar_index
        gxTopK := f_topK(gs0)
        gxSigK := f_trustK(gs0, gxTopK)
GexSnap gx = na
if gexIdx >= 0
    gx := array.get(gexSnaps, gexIdx)
bool  gexOn  = not na(gx) and not na(gexRatio)
float gxFlip = na
float gxCw   = na
float gxPw   = na
array<float> gxLv = array.new<float>()
if gexOn
    gxFlip := gx.flip * gexRatio
    gxCw := gx.cw * gexRatio
    gxPw := gx.pw * gexRatio
    gxLv := f_lvls(gx, gxSigK)

// What the chart shows: on the last bar, the newest snapshot even if it was taken after
// that bar (a weekend or pre-market run), so the levels on screen are always the latest.
// The signals above stick to the snapshot in force at each bar.
GexSnap gxD = gx
float gxDF = gxFlip
float gxDC = gxCw
float gxDP = gxPw
array<float> gxDTop = gxTopK
array<float> gxDK   = gxSigK
array<float> gxDLv  = gxLv
if barstate.islast and array.size(gexSnaps) > 0 and not na(gexRatio)
    GexSnap nw = array.last(gexSnaps)
    if na(gx) or nw.ts > gx.ts
        gxD := nw
        gxDF := nw.flip * gexRatio
        gxDC := nw.cw * gexRatio
        gxDP := nw.pw * gexRatio
        gxDTop := f_topK(nw)
        gxDK := f_trustK(nw, gxDTop)
        gxDLv := f_lvls(nw, gxDK)
bool gexShowOn = not na(gxD) and not na(gexRatio)

// A GEX level tested and held this bar, with absorption or a delta reversal on it.
float gxTol = gexTolAtr * atr
float gxSup = na
float gxRes = na
for lv in gxLv
    if low <= lv + gxTol and close > lv and (na(gxSup) or math.abs(close - lv) < math.abs(close - gxSup))
        gxSup := lv
    if high >= lv - gxTol and close < lv and (na(gxRes) or math.abs(close - lv) < math.abs(close - gxRes))
        gxRes := lv
bool   dRevBull = (deltaZ[1] <= -dzMin or buyPct[1] <= 100 - buyDomPct) and buyersDom
bool   dRevBear = (deltaZ[1] >= dzMin or buyPct[1] >= buyDomPct) and sellersDom
bool   gxLong   = not na(gxSup) and (absBull or dRevBull)
bool   gxShort  = not na(gxRes) and (absBear or dRevBear)
string gxRegime = na(gxFlip) ? "" : close > gxFlip ? "positive gamma, above the flip" : "negative gamma, below the flip"

// Each strong strike (the walls and the 8 biggest) gets a status for the day: held when
// a candle tests it and closes back on its side with absorption or a delta flip, broke
// when a candle closes through it with delta behind the move. Touches are counted so
// retests show. The first outcome per level per day feeds the held / tested record.
if barstate.isconfirmed and gexOn
    array<float> strong = array.copy(gxTopK)
    if not na(gx.cw)
        array.push(strong, gx.cw)
    if not na(gx.pw)
        array.push(strong, gx.pw)
    for k in strong
        float y   = k * gexRatio
        int   key = int(math.round(k * 100))
        if low <= y + gxTol and high >= y - gxTol
            if not (low[1] <= y + gxTol and high[1] >= y - gxTol)
                map.put(lvTouch, key, nz(map.get(lvTouch, key)) + 1)
            bool fromAbove = close[1] > y
            int  st    = nz(map.get(lvStat, key))
            bool held  = fromAbove ? close > y and (absBull or dRevBull) : close < y and (absBear or dRevBear)
            bool broke = fromAbove ? close < y - gxTol and sellersDom : close > y + gxTol and buyersDom
            if broke and st != -1
                map.put(lvStat, key, -1)
                if st == 0
                    lvBrokeN += 1
            else if held and st == 0
                map.put(lvStat, key, 1)
                lvHeldN += 1

f_nextLevel(array<float> lvls, int dir, float entry, float risk) =>
    float best = na
    for x in lvls
        if (x - entry) * dir >= minRR * risk and (na(best) or math.abs(x - entry) < math.abs(best - entry))
            best := x
    na(best) ? entry + dir * 2.0 * risk : best

// 10. GEX + anchored VWAP. GEX says where price may turn; a VWAP anchored at the start
// of the move into the level says whether that move is still in control. A test is a
// candle reaching a level after a move of at least gaMinMove ATR, with price still on
// the move's side of the AVWAP (anchored at the move's start: the highest high or
// lowest low of the last gaLook bars). Then:
//   reversal: price holds the level and closes back through the AVWAP. Trade back
//   toward the next level, stop past the extreme of the test.
//   continuation: price closes through the level while the AVWAP holds, moves away,
//   then retests the level from the other side and holds. Trade with the move, stop
//   past the level; a close back through the AVWAP ends it.
// The idea is dropped when the AVWAP gives way first, price reclaims a broken level,
// or nothing happens within gaWait bars.
float gaCumPV = ta.cum(hlc3 * nz(volume))
float gaCumV  = ta.cum(nz(volume))
int   gaHiAgo = -ta.highestbars(high, gaLook)
int   gaLoAgo = -ta.lowestbars(low, gaLook)
// The AVWAP from a start whose running totals just before it were pv0 and v0.
f_avw(float pv0, float v0) =>
    float v = gaCumV - v0
    na(pv0) or na(v0) or v <= 0 ? na : (gaCumPV - pv0) / v

var int   gaMove   = 0      // the move into the level: -1 down into support, 1 up into resistance
var int   gaPhase  = 0      // 0 idle, 1 at the level, 2 broke it and waiting for the retest
var float gaLvl    = na
var int   gaAnchor = na
var float gaPV0    = na     // running totals before the anchor
var float gaV0     = na
var int   gaBar    = na
var float gaExt    = na
var bool  gaAway   = false
var int   gaTrAnchor = na   // the open trade's anchor, totals, move and type
var float gaTrPV0    = na
var float gaTrV0     = na
var int   gaTrMove   = 0
var bool  gaTrCont   = false
int    gaTrig  = 0
float  gaStop  = na
string gaWhy   = ""
float  gaAv    = f_avw(gaPV0, gaV0)
float  gaTrAv  = f_avw(gaTrPV0, gaTrV0)
if barstate.isconfirmed and useGA
    int m = gaMove
    if gaPhase == 1
        gaExt := m == -1 ? math.min(gaExt, low) : math.max(gaExt, high)
        if not na(gaAv) and (m == -1 ? close > gaAv and close > gaLvl : close < gaAv and close < gaLvl)
            gaTrig := -m
            gaStop := m == -1 ? gaExt - stopAtr * atr : gaExt + stopAtr * atr
            gaWhy  := "Held GEX " + f_px(gaLvl) + " and closed back " + (m == -1 ? "above" : "below") + " the AVWAP " + f_px(gaAv)
            gaPhase := 0
        else if not na(gaAv) and (m == -1 ? close < gaLvl - gxTol and close < gaAv : close > gaLvl + gxTol and close > gaAv)
            gaPhase := 2
            gaBar := bar_index
            gaAway := m == -1 ? close < gaLvl - gxTol - 0.5 * atr : close > gaLvl + gxTol + 0.5 * atr
        else if bar_index - gaBar > gaWait
            gaPhase := 0
    else if gaPhase == 2
        if na(gaAv) or (m == -1 ? close > gaAv : close < gaAv)
            gaPhase := 0
        else if m == -1 ? close > gaLvl + gxTol : close < gaLvl - gxTol
            gaPhase := 0
        else if gaAway and bar_index > gaBar and (m == -1 ? high >= gaLvl - gxTol and close < gaLvl : low <= gaLvl + gxTol and close > gaLvl)
            gaTrig := m
            gaStop := m == -1 ? math.max(high, gaLvl) + stopAtr * atr : math.min(low, gaLvl) - stopAtr * atr
            gaWhy  := "Broke GEX " + f_px(gaLvl) + " with the AVWAP " + f_px(gaAv) + " holding, and the retest held"
            gaPhase := 0
        else if bar_index - gaBar > gaWait
            gaPhase := 0
        else if not gaAway
            gaAway := m == -1 ? low < gaLvl - gxTol - 0.5 * atr : high > gaLvl + gxTol + 0.5 * atr
    // A new test, when no idea is open.
    if gaPhase == 0 and gaTrig == 0 and gexOn
        float lvDn = na
        float lvUp = na
        for lv in gxLv
            if close[1] > lv and low <= lv + gxTol and (na(lvDn) or lv > lvDn)
                lvDn := lv
            if close[1] < lv and high >= lv - gxTol and (na(lvUp) or lv < lvUp)
                lvUp := lv
        bool dnOk = not na(lvDn) and gaHiAgo >= 3 and high[gaHiAgo] - low >= gaMinMove * atr
        bool upOk = not na(lvUp) and gaLoAgo >= 3 and high - low[gaLoAgo] >= gaMinMove * atr
        // Both at once (a wide bar): the side the bar closed toward.
        if dnOk and upOk
            dnOk := close < open
            upOk := not dnOk
        int   nm  = dnOk ? -1 : upOk ? 1 : 0
        int   ago = nm == -1 ? gaHiAgo : nm == 1 ? gaLoAgo : na
        float pv0 = na(ago) or ago >= 990 ? na : ago < bar_index ? gaCumPV[ago + 1] : 0.0
        float v0  = na(ago) or ago >= 990 ? na : ago < bar_index ? gaCumV[ago + 1] : 0.0
        float av0 = f_avw(pv0, v0)
        float lv0 = nm == -1 ? lvDn : lvUp
        if nm != 0 and not na(av0) and (nm == -1 ? close < av0 : close > av0)
            gaMove := nm
            gaLvl := lv0
            gaAnchor := bar_index - ago
            gaPV0 := pv0
            gaV0 := v0
            gaBar := bar_index
            gaExt := nm == -1 ? low : high
            gaAway := false
            gaPhase := 1
            // The test candle can break the level outright.
            if nm == -1 ? close < lv0 - gxTol : close > lv0 + gxTol
                gaPhase := 2
                gaAway := nm == -1 ? close < lv0 - gxTol - 0.5 * atr : close > lv0 + gxTol + 0.5 * atr
float gaAvNow = f_avw(gaPV0, gaV0)

// Entries and exits, on candle close.
bool anyStratEntry = false
if barstate.isconfirmed
    bool flatBO = sBO.dir == 0
    f_manage(sBO, false, "")
    if flatBO and useBO and sOk and (boLong or boShort)
        int   d  = boLong ? 1 : -1
        float sl = d == 1 ? math.min(low, boHi) - 0.1 * atr : math.max(high, boLo) + 0.1 * atr
        float rk = math.abs(close - sl)
        float mm = d == 1 ? boHi + boH - close : close - (boLo - boH)
        if rk > mintickSafe and rk <= maxRiskAtr * atr
            f_open(sBO, d, sl, close + d * math.max(2 * rk, mm), na, false, 0, "Range " + f_px(boLo) + " – " + f_px(boHi) + " · volume " + str.tostring(rvol, "0.0") + "x")
            anyStratEntry := true

    bool flatPB = sPB.dir == 0
    f_manage(sPB, false, "")
    if flatPB and usePB and sOk and (pbLong or pbShort)
        int   d  = pbLong ? 1 : -1
        float sl = d == 1 ? lo5 - 0.1 * atr : hi5 + 0.1 * atr
        float rk = math.abs(close - sl)
        float tg = d == 1 ? (legDir == 1 ? legHigh : hi20) : (legDir == -1 ? legLow : lo20)
        if rk > mintickSafe and rk <= maxRiskAtr * atr and (tg - close) * d >= minRR * rk
            f_open(sPB, d, sl, tg, na, false, 0, (d == 1 ? "Dip in an uptrend" : "Rally in a downtrend") + " · target the last swing")
            anyStratEntry := true

    bool flatRG = sRG.dir == 0
    f_manage(sRG, false, "")
    if flatRG and useRG and sOk and (rgLong or rgShort)
        int   d  = rgLong ? 1 : -1
        float sl = d == 1 ? math.min(low, rgLo) - stopAtr * atr : math.max(high, rgHi) + stopAtr * atr
        float rk = math.abs(close - sl)
        float rt2 = d == 1 ? rgHi - 0.05 * rgH : rgLo + 0.05 * rgH
        if rk > mintickSafe and rk <= maxRiskAtr * atr and (rt2 - close) * d >= minRR * rk
            f_open(sRG, d, sl, rgMid, rt2, true, 0, "Range " + f_px(rgLo) + " – " + f_px(rgHi) + " · ADX " + str.tostring(adxV, "#") + " · target 1 is the middle")
            anyStratEntry := true

    bool flatMR = sMR.dir == 0
    if not flatMR
        sMR.tp1 := mrMean
    f_manage(sMR, false, "")
    if flatMR and useMR and sOk and (mrLong or mrShort)
        int   d  = mrLong ? 1 : -1
        float sl = d == 1 ? lo3 - 0.1 * atr : hi3 + 0.1 * atr
        float rk = math.abs(close - sl)
        if rk > mintickSafe and rk <= maxRiskAtr * atr and (mrMean - close) * d >= minRR * rk
            f_open(sMR, d, sl, mrMean, na, false, 0, "RSI " + str.tostring(rsi14, "#") + " · back inside the band · target the mean")
            anyStratEntry := true

    bool flatNW = sNW.dir == 0
    f_manage(sNW, false, "")
    if flatNW and useNW and (nwLong or nwShort)
        int   d  = nwLong ? 1 : -1
        float sl = d == 1 ? lo3 - 0.5 * atr : hi3 + 0.5 * atr
        float rk = math.abs(close - sl)
        if rk > mintickSafe
            f_open(sNW, d, sl, close + d * 0.5 * nwTpR * rk, close + d * nwTpR * rk, true, nwWinBars, nwName + " release · move " + f_px(nwLo) + " – " + f_px(nwHi))
            anyStratEntry := true
        nwState := 0

    bool flatSC = sSC.dir == 0
    f_manage(sSC, (sSC.dir == 1 and close < ema9) or (sSC.dir == -1 and close > ema9), "Momentum lost")
    if flatSC and useSC and sOk and (scLong or scShort)
        int   d  = scLong ? 1 : -1
        float rk = math.max(scStopAtr * atr, syminfo.mintick * 2)
        f_open(sSC, d, close - d * rk, close + d * scTpR * rk, na, false, 0, "EMA 9 " + (d == 1 ? "over" : "under") + " 21 · micro " + (d == 1 ? "high " + f_px(mHi) : "low " + f_px(mLo)) + " broken")
        anyStratEntry := true

    bool flatOF = sOF.dir == 0
    f_manage(sOF, false, "")
    if flatOF and useOF and sOk and (ofLong or ofShort)
        int   d  = ofLong ? 1 : -1
        float sl = d == 1 ? abLo - 0.1 * atr : abHi + 0.1 * atr
        float rk = math.abs(close - sl)
        if rk > mintickSafe and rk <= maxRiskAtr * atr
            f_open(sOF, d, sl, f_target(d, close, rk, vwapV, poc, prevPoc), na, false, 0, "Absorption at " + f_px(d == 1 ? abLo : abHi) + " held · target VWAP or POC")
            anyStratEntry := true
        abDir := 0

    // The spread is scored in percent: the ratio's return from entry to exit.
    bool flatSP = sSP.dir == 0
    if not flatSP and bar_index > sSP.bar and not na(spZ)
        if (sSP.dir == 1 and spZ >= 0) or (sSP.dir == -1 and spZ <= 0)
            f_close(sSP, spRatio, "Spread back at its mean")
        else if math.abs(spZ) >= spStopZ
            f_close(sSP, spRatio, "Spread past " + str.tostring(spStopZ, "#.#") + " sigma")
    if flatSP and useSP and (spLong or spShort) and math.abs(spZ) < spStopZ
        int d = spLong ? 1 : -1
        sSP.dir := d
        sSP.entry := spRatio
        sSP.risk := spRatio / 100
        sSP.stop := na
        sSP.tp1 := spMean
        sSP.tp2 := na
        sSP.bar := bar_index
        string legs = d == 1 ? "buy " + syminfo.ticker + ", sell " + spName : "sell " + syminfo.ticker + ", buy " + spName
        if stratLabels
            label.new(bar_index, d == 1 ? low : high, (d == 1 ? "▲ " : "▼ ") + "SPR", style = d == 1 ? label.style_label_up : label.style_label_down, color = color.new(d == 1 ? cBull : cBear, 35), textcolor = color.white, size = size.tiny, tooltip = "Spread: " + legs + "\nz " + str.tostring(spZ, "0.0") + " · exit at 0 · stop past " + str.tostring(spStopZ, "#.#"))
        alert("Spread: " + legs + " (" + f_tf(timeframe.period) + ") · z " + str.tostring(spZ, "0.0"), alert.freq_once_per_bar_close)
        anyStratEntry := true

    bool flatGX = sGX.dir == 0
    f_manage(sGX, false, "")
    if flatGX and useGX and sOk and gexOn and (gxLong or gxShort)
        int   d   = gxLong ? 1 : -1
        float lvl = d == 1 ? gxSup : gxRes
        float sl  = d == 1 ? math.min(low, lvl) - stopAtr * atr : math.max(high, lvl) + stopAtr * atr
        float rk  = math.abs(close - sl)
        if rk > mintickSafe and rk <= maxRiskAtr * atr
            f_open(sGX, d, sl, f_nextLevel(gxLv, d, close, rk), na, false, 0, "GEX level " + f_px(lvl) + " held · " + ((d == 1 ? absBull : absBear) ? "absorption" : "delta reversal") + (gxRegime == "" ? "" : " · " + gxRegime))
            anyStratEntry := true

    // GEX + AVWAP: a continuation trade also ends on a close back through its AVWAP.
    bool flatGA = sGA.dir == 0
    f_manage(sGA, gaTrCont and not na(gaTrAv) and (sGA.dir == 1 ? close < gaTrAv : close > gaTrAv), "Closed back through the AVWAP")
    if flatGA and useGA and sOk and gaTrig != 0
        int   d  = gaTrig
        float rk = (close - gaStop) * d
        if rk > mintickSafe and rk <= maxRiskAtr * atr
            f_open(sGA, d, gaStop, f_nextLevel(gxLv, d, close, rk), na, false, 0, gaWhy + (gxRegime == "" ? "" : " · " + gxRegime))
            gaTrAnchor := gaAnchor
            gaTrPV0 := gaPV0
            gaTrV0 := gaV0
            gaTrMove := gaMove
            gaTrCont := d == gaMove
            anyStratEntry := true

alertcondition(anyStratEntry, "Strategy entry (any)", "ICT Dash: a strategy entry fired on {{ticker}} {{interval}}")

// GEX on the chart. Trusted only (the default): the call wall, the put wall and the
// gamma flip, plus any of the 8 biggest strikes where today's option volume is heavy
// too (★ flow), until it breaks. Strong levels: the walls, the flip and the 8 biggest.
// Full ladder adds every strike within the chosen range, green for positive GEX and
// red for negative, bolder for more gamma. The walls and the 3 biggest strikes are
// grade A, the next 5 grade B. L below price (support: look for a bounce long), S
// above (resistance: look for a bounce short). Status: ✓ held (a test closed back with
// absorption or a delta flip), ✗ broke (closed through with delta behind it, don't
// fade it), or retest (touched before, weaker). OV marks today's busiest option
// strikes: teal when calls dominate, pink when puts do. Hover any tag for details.
var array<line>  gxLines  = array.new<line>()
var array<label> gxLabels = array.new<label>()
f_glabel(float y, color c, string txt, string sz, string tip) =>
    label.new(bar_index + 3, y, txt, style = label.style_label_left, color = color.new(#0f172a, 25), textcolor = c, size = sz, tooltip = tip)
f_gexAt(GexSnap s, float k) =>
    float out = na
    for [i, kk] in s.ks
        if kk == k
            out := array.get(s.gs, i)
    out
f_near(array<float> placed, float y) =>
    bool out = false
    for d in placed
        if math.abs(d - y) <= 0.5 * atr
            out := true
    out
// Tag text, color and tooltip for a strong level. fi: its options-flow index, or -1.
f_tag(float k, float y, string grade, string name, float gv, int fi) =>
    int    key  = int(math.round(k * 100))
    int    st   = nz(map.get(lvStat, key))
    int    tch  = nz(map.get(lvTouch, key))
    bool   isL  = y < close
    string dir  = isL ? "L" : "S"
    string stat = st == 1 ? "  ✓ held" : st == -1 ? "  ✗ broke" : tch >= 2 ? "  · retest" : ""
    color  c    = st == -1 ? cNeu : color.new(isL ? cBull : cBear, st == 0 and tch >= 2 ? 45 : 0)
    string txt  = grade + " " + dir + "  " + name + f_px(y) + (na(gv) ? "" : " · " + f_signed(gv, "#.##") + "B") + (fi >= 0 ? "  ★ flow" : "") + stat
    string flw  = fi >= 0 ? " ★ flow: heavy option volume here today too (" + f_k(array.get(gxD.vc, fi)) + " calls, " + f_k(array.get(gxD.vp, fi)) + " puts), so the level is more likely to matter." : ""
    string tip  = "Grade " + grade + (grade == "A" ? " (a wall or one of the 3 biggest strikes)" : " (one of the next 5 biggest strikes)") + "." + flw + " " + (isL ? "Support below price: look for a bounce long." : "Resistance above price: look for a bounce short.") + " Wait for a candle to close at the level with absorption or delta flipping " + (isL ? "up" : "down") + ", then enter on the pullback, not the spike. " + (st == 1 ? "Today: it held." : st == -1 ? "Today: it broke with delta behind it, so don't fade it." : tch >= 2 ? "Tested " + str.tostring(tch) + " times today, so it's weaker." : tch == 1 ? "Tested once today, no clear result yet." : "Not tested yet today.")
    [txt, c, tip]
if barstate.islast
    for ln in gxLines
        line.delete(ln)
    for lb in gxLabels
        label.delete(lb)
    array.clear(gxLines)
    array.clear(gxLabels)
    if showGex and gexShowOn
        int   x1  = math.max(nz(gexStartBar, bar_index - 100), bar_index - 300)
        float lo  = close * (1 - gexRange / 100)
        float hi  = close * (1 + gexRange / 100)
        float far = close * 2 * gexRange / 100
        if gexMode == "Full ladder"
            // Strength is scaled to the 85th percentile of the strikes in range, so one
            // huge wall doesn't wash out every other level.
            array<float> inRange = array.new<float>()
            for [i, kk] in gxD.ks
                float y = kk * gexRatio
                if y >= lo and y <= hi
                    array.push(inRange, math.abs(array.get(gxD.gs, i)))
            float gMax = array.size(inRange) > 0 ? array.percentile_nearest_rank(inRange, 85) : 0.0
            if gMax > 0
                for [i, kk] in gxD.ks
                    float y = kk * gexRatio
                    if y >= lo and y <= hi
                        float gv = array.get(gxD.gs, i)
                        float sh = math.min(1.0, math.abs(gv) / gMax)
                        int   tr = int(math.round(60 - 60 * math.sqrt(sh)))
                        array.push(gxLines, line.new(x1, y, bar_index + 3, y, color = color.new(gv >= 0 ? cBull : cBear, tr), width = 1 + int(math.round(3 * sh)), style = sh >= 0.15 ? line.style_solid : line.style_dotted))
        array<float> placed = array.new<float>()
        if not na(gxDC) and math.abs(gxDC - close) <= far
            [tg1, cg1, pg1] = f_tag(gxD.cw, gxDC, "A", "Call wall ", f_gexAt(gxD, gxD.cw), f_flowAt(gxD, gxD.cw))
            array.push(gxLines, line.new(x1, gxDC, bar_index + 3, gxDC, color = f_broke(gxD.cw) ? cNeu : cBull, width = 3))
            array.push(gxLabels, f_glabel(gxDC, cg1, tg1, size.small, pg1))
            array.push(placed, gxDC)
        if not na(gxDP) and math.abs(gxDP - close) <= far
            [tg2, cg2, pg2] = f_tag(gxD.pw, gxDP, "A", "Put wall ", f_gexAt(gxD, gxD.pw), f_flowAt(gxD, gxD.pw))
            array.push(gxLines, line.new(x1, gxDP, bar_index + 3, gxDP, color = f_broke(gxD.pw) ? cNeu : cBear, width = 3))
            array.push(gxLabels, f_glabel(gxDP, cg2, tg2, size.small, pg2))
            array.push(placed, gxDP)
        if not na(gxDF) and math.abs(gxDF - close) <= far
            array.push(gxLines, line.new(x1, gxDF, bar_index + 3, gxDF, color = cWarn, width = 2, style = line.style_dashed))
            array.push(gxLabels, f_glabel(gxDF, cWarn, "γ flip " + f_px(gxDF) + (close > gxDF ? " · price above (+γ, calmer)" : " · price below (−γ, faster)"), size.small, "Gamma flip: above it moves tend to be calm and levels hold more; below it moves are faster and levels break more often."))
            array.push(placed, gxDF)
        // The 8 biggest strikes: 3 grade A, 5 grade B. Trusted only shows the ones with
        // ★ flow that haven't broken today.
        array<float> absg = array.new<float>()
        for g in gxD.gs
            array.push(absg, math.abs(g))
        array<int> ord = array.sort_indices(absg, order.descending)
        int rank = 0
        for ix in ord
            if rank < 8
                float kx = array.get(gxD.ks, ix)
                if kx != gxD.cw and kx != gxD.pw
                    rank += 1
                    float y = kx * gexRatio
                    if y >= lo and y <= hi and array.includes(gxDK, kx) and not (gxTrusted and f_broke(kx)) and not f_near(placed, y)
                        [tg3, cg3, pg3] = f_tag(kx, y, rank <= 3 ? "A" : "B", "", array.get(gxD.gs, ix), f_flowAt(gxD, kx))
                        if gexMode != "Full ladder"
                            array.push(gxLines, line.new(x1, y, bar_index + 3, y, color = color.new(cg3, rank <= 3 ? 0 : 30), width = rank <= 3 ? 2 : 1))
                        array.push(gxLabels, f_glabel(y, cg3, tg3, rank <= 3 ? size.small : size.tiny, pg3))
                        array.push(placed, y)
        // Options flow: today's busiest strikes, busiest first. One that sits on a GEX
        // tag is left to the tag's ★ flow.
        if showOV and array.size(gxD.vk) > 0
            array<float> tot = array.new<float>()
            for [i, v] in gxD.vk
                array.push(tot, array.get(gxD.vc, i) + array.get(gxD.vp, i))
            array<int> ovOrd = array.sort_indices(tot, order.descending)
            string combo = gexName == "SPX" ? "SPX + SPY" : gexName == "NDX" ? "NDX + QQQ" : gexName == "RUT" ? "RUT + IWM" : gexName == "DIA" ? "DIA + DJX" : gexName
            int shown = 0
            for ix in ovOrd
                float k = array.get(gxD.vk, ix)
                float y = k * gexRatio
                if shown < nOV and math.abs(y - close) <= far
                    shown += 1
                    if not f_near(placed, y)
                        float c  = array.get(gxD.vc, ix)
                        float p  = array.get(gxD.vp, ix)
                        color oc = c >= 1.5 * p ? cOVc : p >= 1.5 * c ? cOVp : cText
                        array.push(gxLines, line.new(x1, y, bar_index + 3, y, color = color.new(oc, 25), width = 1, style = line.style_dotted))
                        array.push(gxLabels, f_glabel(y, oc, "OV  " + f_px(y) + " · " + f_k(c) + " C / " + f_k(p) + " P", size.tiny, "Options flow: one of today's busiest strikes near price (" + combo + " options, strike " + str.tostring(k) + ", volume as of " + str.format_time(gxD.ts, "HH:mm", "America/New_York") + " ET). " + (c >= 1.5 * p ? "Mostly calls." : p >= 1.5 * c ? "Mostly puts." : "Calls and puts about even.") + " Busy strikes often pull price in or stall it, most of all where they also carry big GEX (★ flow on a GEX tag)."))
                        array.push(placed, y)

// The anchored VWAP: the open idea's or trade's (solid), else the current move's
// (dotted), from the move's start to now.
var polyline gaPoly = na
var label    gaLab  = na
if barstate.islast
    polyline.delete(gaPoly)
    label.delete(gaLab)
    if useGA and gaShow
        bool idea   = gaPhase != 0
        bool trade  = not idea and sGA.dir != 0 and not na(gaTrAnchor)
        int  anc    = idea ? gaAnchor : trade ? gaTrAnchor : gaHiAgo < gaLoAgo ? bar_index - gaHiAgo : bar_index - gaLoAgo
        bool fromHi = idea ? gaMove == -1 : trade ? gaTrMove == -1 : gaHiAgo < gaLoAgo
        int  off    = na(anc) ? na : bar_index - anc
        if not na(off) and off >= 3 and off < 990
            float bpv = anc > 0 ? gaCumPV[off + 1] : 0.0
            float bv  = anc > 0 ? gaCumV[off + 1] : 0.0
            array<chart.point> pts = array.new<chart.point>()
            for j = off to 0
                float vv = gaCumV[j] - bv
                if vv > 0
                    array.push(pts, chart.point.from_index(bar_index - j, (gaCumPV[j] - bpv) / vv))
            if array.size(pts) >= 2
                bool solid = idea or trade
                float avNow = array.last(pts).price
                gaPoly := polyline.new(pts, line_color = color.new(cGA, solid ? 0 : 45), line_width = solid ? 2 : 1, line_style = solid ? line.style_solid : line.style_dotted)
                string gaTip = idea ? "Anchored VWAP from the start of the move into GEX " + f_px(gaLvl) + ". " + (gaPhase == 1 ? (gaMove == -1 ? "A close above it means buyers took over: long. A break of the level with it holding means short the retest." : "A close below it means sellers took over: short. A break of the level with it holding means long the retest.") : (gaMove == -1 ? "The level broke with it holding: short a retest of " + f_px(gaLvl) + " that holds. A close above it ends the idea." : "The level broke with it holding: long a retest of " + f_px(gaLvl) + " that holds. A close below it ends the idea.")) : trade ? "Anchored VWAP of the open GEX + AVWAP trade." : "Anchored VWAP from the start of the current move (the " + (fromHi ? "high" : "low") + " of the last " + str.tostring(gaLook) + " bars). Price is " + (close > avNow ? "above" : "below") + " it, so " + (close > avNow ? "buyers" : "sellers") + " control the move. When price reaches a GEX level, watch whether it closes back through this line."
                gaLab := label.new(anc, fromHi ? high[off] : low[off], "AVWAP", style = fromHi ? label.style_label_down : label.style_label_up, color = color.new(cGA, solid ? 20 : 60), textcolor = color.white, size = size.tiny, tooltip = gaTip)

// -------------------------------------------------------------- drawings --
var line fibLine = na
var label fibLabel = na
if barstate.islast and showFib
    line.delete(fibLine)
    label.delete(fibLabel)
    if legDir != 0 and not na(fib79) and not na(legOriginBar)
        color fc = legDir == 1 ? cBull : cBear
        fibLine := line.new(legOriginBar, fib79, bar_index + 5, fib79, color = fc, style = line.style_dashed, width = 2)
        fibLabel := label.new(bar_index + 5, fib79, str.tostring(fibLevel * 100, "#.#") + "%  " + f_px(fib79), style = label.style_label_left, color = color.new(fc, 100), textcolor = fc, size = size.small)

plot(delta, "Bar delta", display = display.data_window)
plot(cvd, "Session CVD", display = display.data_window)
plot(rvol, "Relative volume", display = display.data_window)
// Big prints sized by how far past the threshold they are: 1x, 1.5x, 2.25x, 3.5x, 5x.
f_bigTier(float px, float v) =>
    float m = bigThr > 0 ? v / bigThr : 0.0
    not showBig or na(px) ? 0 : m >= 5.0 ? 5 : m >= 3.5 ? 4 : m >= 2.25 ? 3 : m >= 1.5 ? 2 : 1
int bigTierB = f_bigTier(bigBuyPx, bigBuyV)
int bigTierS = f_bigTier(bigSellPx, bigSellV)
plotshape(bigTierB == 1 ? bigBuyPx : na, "Big buy print", shape.circle, location.absolute, color.new(cBull, 20), size = size.tiny, display = display.pane)
plotshape(bigTierB == 2 ? bigBuyPx : na, "Big buy print 1.5x", shape.circle, location.absolute, color.new(cBull, 30), size = size.small, display = display.pane)
plotshape(bigTierB == 3 ? bigBuyPx : na, "Big buy print 2.25x", shape.circle, location.absolute, color.new(cBull, 40), size = size.normal, display = display.pane)
plotshape(bigTierB == 4 ? bigBuyPx : na, "Big buy print 3.5x", shape.circle, location.absolute, color.new(cBull, 45), size = size.large, display = display.pane)
plotshape(bigTierB == 5 ? bigBuyPx : na, "Big buy print 5x", shape.circle, location.absolute, color.new(cBull, 50), size = size.huge, display = display.pane)
plotshape(bigTierS == 1 ? bigSellPx : na, "Big sell print", shape.circle, location.absolute, color.new(cBear, 20), size = size.tiny, display = display.pane)
plotshape(bigTierS == 2 ? bigSellPx : na, "Big sell print 1.5x", shape.circle, location.absolute, color.new(cBear, 30), size = size.small, display = display.pane)
plotshape(bigTierS == 3 ? bigSellPx : na, "Big sell print 2.25x", shape.circle, location.absolute, color.new(cBear, 40), size = size.normal, display = display.pane)
plotshape(bigTierS == 4 ? bigSellPx : na, "Big sell print 3.5x", shape.circle, location.absolute, color.new(cBear, 45), size = size.large, display = display.pane)
plotshape(bigTierS == 5 ? bigSellPx : na, "Big sell print 5x", shape.circle, location.absolute, color.new(cBear, 50), size = size.huge, display = display.pane)
// The GEX + AVWAP anchored VWAP while an idea or a trade is open.
float gaPlotAv = not (useGA and gaShow) ? na : gaPhase != 0 ? f_avw(gaPV0, gaV0) : sGA.dir != 0 ? f_avw(gaTrPV0, gaTrV0) : na
plot(gaPlotAv, "GEX + AVWAP: anchored VWAP", color = cGA, linewidth = 2, style = plot.style_linebr, display = display.pane)

// ---------------------------------------------------------------- alerts --
alertcondition(longSignal, "Long signal", "ICT Dash: LONG on {{ticker}} {{interval}} at {{close}}")
alertcondition(shortSignal, "Short signal", "ICT Dash: SHORT on {{ticker}} {{interval}} at {{close}}")
alertcondition(exitLong, "Sell (exit long)", "ICT Dash: SELL / exit long on {{ticker}} {{interval}} at {{close}}")
alertcondition(exitShort, "Cover (exit short)", "ICT Dash: COVER / exit short on {{ticker}} {{interval}} at {{close}}")
if longSignal or shortSignal
    alert((longSignal ? "LONG " : "SHORT ") + syminfo.ticker + " " + f_tf(timeframe.period) + " @ " + f_px(entryPx) + " | stop " + f_px(stopPx) + " | TP1 " + f_px(tp1Px) + " | TP2 " + f_px(tp2Px), alert.freq_once_per_bar_close)
if exitLong or exitShort
    alert((exitLong ? "SELL " : "COVER ") + syminfo.ticker + " " + f_tf(timeframe.period) + " @ " + f_px(exitPx) + " | " + exitWhy, alert.freq_once_per_bar_close)

// ------------------------------------------------------------ record text --
f_rec(Strat s) =>
    s.n == 0 ? "no trades yet" : str.tostring(100.0 * s.wins / s.n, "#") + "% won · " + f_signed(s.totR / s.n, "#.##") + s.unit + " · " + str.tostring(s.n)

// ------------------------------------------------------------- dashboard --
string tblPos = dashPos == "Top left" ? position.top_left : dashPos == "Bottom right" ? position.bottom_right : dashPos == "Bottom left" ? position.bottom_left : position.top_right
string txtSize = dashSize == "Tiny" ? size.tiny : dashSize == "Normal" ? size.normal : size.small
var table dash = table.new(tblPos, 2, 17, bgcolor = color.new(#0b1220, 10), frame_color = color.new(#334155, 0), frame_width = 1, border_color = color.new(#1e293b, 0), border_width = 1)

f_row(int row, string key, string val, color vc, string tip = "") =>
    table.cell(dash, 0, row, key, text_color = cKey, text_size = txtSize, text_halign = text.align_left)
    table.cell(dash, 1, row, val, text_color = vc, text_size = txtSize, text_halign = text.align_left, tooltip = tip)

if barstate.islast
    // Nearest support below / resistance above, FVG or IFVG.
    float supTop = na
    float supBot = na
    bool  supInv = false
    float resTop = na
    float resBot = na
    bool  resInv = false
    if array.size(gaps) > 0
        for i = 0 to array.size(gaps) - 1
            Gap g = array.get(gaps, i)
            if g.dir == 1 and g.bot <= close and (na(supTop) or g.top > supTop)
                supTop := g.top
                supBot := g.bot
                supInv := g.inverse
            if g.dir == -1 and g.top >= close and (na(resBot) or g.bot < resBot)
                resTop := g.top
                resBot := g.bot
                resInv := g.inverse
    int nHeld = 0
    int nBroken = 0
    int nResHeld = 0
    int nResBroken = 0
    if array.size(ofEvents) > 0
        for i = 0 to array.size(ofEvents) - 1
            int e = array.get(ofEvents, i)
            nHeld += e == 1 ? 1 : 0
            nBroken += e == 2 ? 1 : 0
            nResHeld += e == 3 ? 1 : 0
            nResBroken += e == 4 ? 1 : 0

    table.cell(dash, 0, 0, "ICT Confluence", text_color = cText, text_size = txtSize, text_halign = text.align_left)
    table.cell(dash, 1, 0, syminfo.ticker + " · " + f_tf(timeframe.period), text_color = cText, text_size = txtSize, text_halign = text.align_left)

    string stTxt = trend == 1 ? "▲ Bullish" : trend == -1 ? "▼ Bearish" : "– No break yet"
    if trend == 1 and not na(swingLow)
        stTxt += " · protected low " + f_px(swingLow)
    if trend == -1 and not na(swingHigh)
        stTxt += " · protected high " + f_px(swingHigh)
    f_row(1, "Structure", stTxt, f_color(trend))
    f_row(2, f_tf(tf1) + " / " + f_tf(tf2) + " / " + f_tf(tf3), f_arrow(t1) + "   " + f_arrow(t2) + "   " + f_arrow(t3), bullVotes >= 2 ? cBull : bearVotes >= 2 ? cBear : cNeu)

    string fibName = str.tostring(fibLevel * 100, "#.#") + "%"
    string fibTxt = legDir == 0 ? "No active leg" : (fibName + " at " + f_px(fib79) + (fibRecent ? " · tagged ✓" : (legDir == 1 ? (close > fib79 ? " · below price" : " · reached") : (close < fib79 ? " · above price" : " · reached"))))
    f_row(3, "Fib", fibTxt, legDir == 1 ? cBull : legDir == -1 ? cBear : cNeu)

    string supTxt = na(supTop) ? "none below" : (supInv ? "IFVG " : "FVG ") + f_px(supBot) + " – " + f_px(supTop)
    string resTxt = na(resBot) ? "none above" : (resInv ? "IFVG " : "FVG ") + f_px(resBot) + " – " + f_px(resTop)
    f_row(4, "Support", supTxt, cBull)
    f_row(5, "Resistance", resTxt, cBear)

    string ofTxt = (ofScore > 0 ? "Bullish" : ofScore < 0 ? "Bearish" : "Neutral") + " · " + str.tostring(nHeld + nResBroken) + " bullish vs " + str.tostring(nBroken + nResHeld) + " bearish"
    string ofTip = "Last " + str.tostring(ofMemory) + " gap reactions\nSupport respected: " + str.tostring(nHeld) + "\nSupport disrespected: " + str.tostring(nBroken) + "\nResistance respected: " + str.tostring(nResHeld) + "\nResistance disrespected: " + str.tostring(nResBroken)
    f_row(6, "Order flow", ofTxt, ofScore > 0 ? cBull : ofScore < 0 ? cBear : cNeu, ofTip)

    string dTxt = str.tostring(delta, format.volume) + " · z " + f_signed(deltaZ, "0.0") + " · buyers " + str.tostring(buyPct, "#") + "% · CVD " + (cvdRising ? "▲" : cvdFalling ? "▼" : "–") + " " + str.tostring(cvdBars) + " bars" + (bullDiv ? " · bull divergence" : bearDiv ? " · bear divergence" : "")
    f_row(7, "Delta", dTxt, buyersDom ? cBull : sellersDom ? cBear : cNeu, "Unusual when z is past ±" + str.tostring(dzMin, "0.0") + " against the last " + str.tostring(dzLen) + " bars, or when one side has " + str.tostring(buyDomPct, "#") + "% of the volume. The CVD arrow needs net delta over " + str.tostring(cvdBars) + " bars, most of them the same way.")
    string flTxt = f_signed(flowScore, "0.00") + (rvol < 0.5 ? " · volume too thin" : flowScore >= 0.5 ? " · buyers in control" : flowScore <= -0.5 ? " · sellers in control" : flowScore >= 0.2 ? " · leaning buyers" : flowScore <= -0.2 ? " · leaning sellers" : " · mixed")
    string flTip = "Absorption " + f_signed(sfAbs, "0.0") + "\nDelta z " + f_signed(sfVD, "0.00") + "\nBig prints " + f_signed(sfBT, "0.00") + "\nEffort vs result " + f_signed(sfER, "0.00") + "\nCVD slope " + f_signed(sfCvdS, "0.00") + "\nRolling CVD " + f_signed(sfCvdR, "0.00") + "\nVolume " + f_signed(sfVol, "0.00")
    f_row(8, "Flow score", flTxt, flowScore >= 0.2 ? cBull : flowScore <= -0.2 ? cBear : cNeu, flTip)
    f_row(9, "Volume", str.tostring(rvol, "0.00") + "x average", rvol >= 1.5 ? cWarn : rvol >= minRvol ? cText : cNeu)
    float gxUp = na
    float gxDn = na
    for lv in gxDLv
        if lv > close and (na(gxUp) or lv < gxUp)
            gxUp := lv
        if lv < close and (na(gxDn) or lv > gxDn)
            gxDn := lv
    string gxTxt = gexName == "" ? "No options mapping for this symbol" : array.size(gexSnaps) == 0 ? "Paste gex/history.txt into the settings" : not gexShowOn ? "Waiting for a regular-hours bar to line up prices" : (na(gxDF) ? "No flip" : (close > gxDF ? "+γ above flip " : "−γ below flip ") + f_px(gxDF)) + " · next ↑ " + f_px(gxUp) + " ↓ " + f_px(gxDn) + (not na(gxSup) or not na(gxRes) ? " · at a level" : "") + (lvHeldN + lvBrokeN > 0 ? " · held " + str.tostring(lvHeldN) + "/" + str.tostring(lvHeldN + lvBrokeN) : "")
    string gxTip = ""
    if gexShowOn
        gxTip := gexName + " snapshot " + str.format_time(gxD.ts, "MMM d HH:mm", "America/New_York") + " ET." + (na(gxDF) ? "" : " Price is " + f_px(math.abs(close - gxDF)) + (close > gxDF ? " above" : " below") + " the flip.") + " Walls: put " + f_px(gxDP) + ", call " + f_px(gxDC) + ". Total GEX " + f_signed(gxD.total, "#.##") + "B per 1% move. Above the flip dealers damp moves (mean reversion, walls hold); below it they amplify them."
        if time - gxD.ts > 36 * 3600000
            gxTxt += " · old: " + str.format_time(gxD.ts, "MMM d", "America/New_York")
    f_row(10, "GEX", gxTxt, not gexShowOn or na(gxDF) ? cNeu : close > gxDF ? cText : cWarn, gxTip)
    f_row(11, "Session", sessName + (inSess ? " ✓" : ""), inSess ? cBull : cNeu)
    f_row(12, "Score long / short", str.tostring(scoreL) + "/8  ·  " + str.tostring(scoreS) + "/8", scoreL >= minScore ? cBull : scoreS >= minScore ? cBear : cText)

    string act = ""
    color actC = cText
    string sessTxt = useSess and not inSess ? ", in a session" : ""
    if pos == 1
        act := "IN LONG " + f_px(entryPx) + " · stop " + f_px(stopPx) + " · sell at " + f_px(tp1Px) + (tp1Done ? " ✓" : "") + " / " + f_px(tp2Px)
        actC := cBull
        if delta < 0 and close < open and rvol >= 1.5
            act += " · selling pressure"
            actC := cWarn
    else if pos == -1
        act := "IN SHORT " + f_px(entryPx) + " · stop " + f_px(stopPx) + " · cover at " + f_px(tp1Px) + (tp1Done ? " ✓" : "") + " / " + f_px(tp2Px)
        actC := cBear
        if delta > 0 and close > open and rvol >= 1.5
            act += " · buying pressure"
            actC := cWarn
    else if exitLong or exitShort
        act := (exitLong ? "SELL now: " : "COVER now: ") + exitWhy
        actC := cWarn
    else if trend == 1 and htfLong
        bool inSup = not na(supTop) and close <= supTop
        bool atFibL = legDir == 1 and (fibRecent or close <= fib79 + fibTol)
        if inSup or atFibL
            act := "At " + (inSup ? "support " + f_px(supBot) + " – " + f_px(supTop) : fibName + " level " + f_px(fib79)) + ": wait for a bullish close" + sessTxt
        else
            act := "Wait for a pullback to " + (legDir == 1 ? f_px(fib79) : "the " + fibName + " level") + (na(supTop) ? "" : " or support " + f_px(supTop)) + sessTxt
        actC := cBull
    else if trend == -1 and htfShort
        bool inRes = not na(resBot) and close >= resBot
        bool atFibS = legDir == -1 and (fibRecent or close >= fib79 - fibTol)
        if inRes or atFibS
            act := "At " + (inRes ? "resistance " + f_px(resBot) + " – " + f_px(resTop) : fibName + " level " + f_px(fib79)) + ": wait for a bearish close" + sessTxt
        else
            act := "Wait for a rally to " + (legDir == -1 ? f_px(fib79) : "the " + fibName + " level") + (na(resBot) ? "" : " or resistance " + f_px(resBot)) + sessTxt
        actC := cBear
    else if trend == 0
        act := "Wait: no break of structure yet"
        actC := cNeu
    else
        act := "Stand aside: timeframes disagree"
        actC := cNeu
    f_row(13, "Now", act, actC)

    string lastTxt = lastExitWhy == "" ? "No exits yet" : "Last exit: " + lastExitWhy + " " + f_signed(lastExitR, "#.##") + "R"
    string histTxt = nTrades == 0 ? "no signals " + sinceTxt : str.tostring(nTrades) + " trades " + sinceTxt + " · " + str.tostring(100.0 * nWins / nTrades, "#") + "% won · avg " + f_signed(sumR / nTrades, "#.##") + "R"
    f_row(14, "History (no fees)", histTxt, nTrades == 0 ? cNeu : sumR >= 0 ? cBull : cBear, lastTxt)

    // GEX + AVWAP: what the setup is waiting for.
    if useGA
        string gaTxt = ""
        color  gaC   = cGA
        if sGA.dir != 0
            gaTxt := "IN " + (sGA.dir == 1 ? "LONG " : "SHORT ") + f_px(sGA.entry) + " · stop " + f_px(sGA.stop) + " · target " + f_px(sGA.tp1) + (gaTrCont and not na(gaTrAv) ? " · out on a close back through " + f_px(gaTrAv) : "")
            gaC := sGA.dir == 1 ? cBull : cBear
        else if gaPhase == 1
            gaTxt := "At GEX " + f_px(gaLvl) + ": " + (gaMove == -1 ? "long on a close above " : "short on a close below ") + f_px(gaAvNow) + " · if it breaks, " + (gaMove == -1 ? "short" : "long") + " the retest"
        else if gaPhase == 2
            gaTxt := "Broke GEX " + f_px(gaLvl) + ": " + (gaMove == -1 ? "short" : "long") + " a retest that holds · off if it closes " + (gaMove == -1 ? "above " : "below ") + f_px(gaAvNow)
        else
            int   mAgo = gaHiAgo < gaLoAgo ? gaHiAgo : gaLoAgo
            float mAv  = na(mAgo) or mAgo < 3 or mAgo >= bar_index or mAgo >= 990 ? na : f_avw(gaCumPV[mAgo + 1], gaCumV[mAgo + 1])
            gaTxt := "No level test yet" + (na(mAv) ? "" : " · move's AVWAP " + f_px(mAv) + (close > mAv ? " (buyers in control)" : " (sellers in control)"))
            gaC := cNeu
        f_row(15, "GEX + AVWAP", gaTxt, gaC, "Reversal: price reaches a GEX level and closes back through the VWAP anchored at the start of the move into it. Continuation: the level breaks while that AVWAP holds, then a retest holds. Record on this chart: " + f_rec(sGA))

    // Kronos forecast (forecast/kronos_forecast.py, every 30 minutes).
    if showFC and fcName != ""
        string fcTxt = "Paste the newest gex/history.txt to see it"
        color  fcC   = cNeu
        string fcTip = "Kronos (github.com/shiyu-coder/Kronos) is an open-source model trained on candlestick charts. The GitHub Action asks it for the next 2 hours of 5-minute bars every 30 minutes. An experiment: don't trade it on its own."
        if not na(fcTs) and not na(fcLast)
            float  d1  = fc1h - fcLast
            float  d2  = fc2h - fcLast
            float  base = nz(fcAt, fcLast)
            array<string> hn = str.split(fcHit, "/")
            int    hh  = array.size(hn) == 2 ? int(nz(str.tonumber(array.get(hn, 0)))) : 0
            int    hN  = array.size(hn) == 2 ? int(nz(str.tonumber(array.get(hn, 1)))) : 0
            bool   old = time - fcTs > 3 * 3600000
            fcTxt := (d2 > 0 ? "▲ " : d2 < 0 ? "▼ " : "– ") + "2h " + f_px(base + d2) + " (" + f_signed(d2, "#.##") + ") · 1h " + f_signed(d1, "#.##") + " · " + (hN == 0 ? "not scored yet" : "right " + str.tostring(hh) + "/" + str.tostring(hN)) + (old ? " · old: " + str.format_time(fcTs, "MMM d HH:mm", "America/New_York") : "")
            fcC := old or hN < 10 or hh < 0.55 * hN ? cNeu : d2 > 0 ? cBull : d2 < 0 ? cBear : cNeu
            fcTip += "\nForecast from " + str.format_time(fcTs, "MMM d HH:mm", "America/New_York") + " ET: 1 hour " + f_px(base + d1) + ", 2 hours " + f_px(base + d2) + ", range " + f_px(base + fcLo - fcLast) + " – " + f_px(base + fcHi - fcLast) + ".\nIts 1-hour direction call was right " + str.tostring(hh) + " of the last " + str.tostring(hN) + " times it was scored. Gray until it has 10 calls scored and 55% right."
        f_row(16, "Kronos 2h", fcTxt, fcC, fcTip)

// ------------------------------------------------------- best long / short --
// Every strategy proposes where it would get in on each side, its stop and its exit.
// The pick is the one with the best record on this chart (average R, pulled toward
// zero when it has few trades) among plans within 4 ATR of price that offer at least
// the minimum reward. Open trades always count. Levels are estimates, not orders.
type Plan
    string src
    float  entry
    float  stop
    float  target
    string how
    float  score
    string rec
    string tip

string bestTblPos = bestPos == "Middle right" ? position.middle_right : bestPos == "Middle left" ? position.middle_left : bestPos == "Top left" ? position.top_left : bestPos == "Bottom left" ? position.bottom_left : position.bottom_right
var table bestTbl = table.new(bestTblPos, 3, 6, bgcolor = color.new(#0b1220, 10), frame_color = color.new(#334155, 0), frame_width = 1, border_color = color.new(#1e293b, 0), border_width = 1)

f_edge(float tot, int n) =>
    tot / (n + 5)

f_plan(array<Plan> plans, int dir, string src, float entry, float sl, float tgt, string how, float score, string rec, string tip, bool live) =>
    if not na(entry) and not na(sl) and not na(tgt)
        float risk = (entry - sl) * dir
        float reward = (tgt - entry) * dir
        if live or (risk > 0 and reward >= minRR * risk and math.abs(entry - close) <= 4 * atr)
            array.push(plans, Plan.new(src, entry, sl, tgt, how, score, rec, tip))
    array.size(plans)

f_livePlan(array<Plan> plans, Strat s, int dir) =>
    if s.dir == dir
        f_plan(plans, dir, s.name, s.entry, s.stop, na(s.tp2) ? s.tp1 : s.tp2, "live", f_edge(s.totR, s.n), f_rec(s), s.name + (dir == 1 ? " long" : " short") + " open since " + f_px(s.entry), true)
    s.dir == dir

f_pick(array<Plan> plans) =>
    Plan best = na
    for p in plans
        if na(best) or p.score > best.score or (p.score == best.score and math.abs(p.entry - close) < math.abs(best.entry - close))
            best := p
    best

f_bcell(int col, int row, string txt, color c, string tip = "") =>
    table.cell(bestTbl, col, row, txt, text_color = c, text_size = txtSize, text_halign = text.align_left, tooltip = tip)

f_bcol(int col, Plan p, int dir) =>
    if na(p)
        f_bcell(col, 1, "No setup within reach", cNeu)
        for rr = 2 to 5
            f_bcell(col, rr, "–", cNeu)
    else
        float risk = (p.entry - p.stop) * dir
        float reward = (p.target - p.entry) * dir
        float gap = math.abs(p.entry - close)
        string dist = p.how == "live" ? (risk > 0 ? "open " + f_signed((close - p.entry) * dir / risk, "#.#") + "R" : "open") : gap <= 0.1 * atr ? "at price" : f_px(gap) + (p.entry < close ? " below" : " above")
        f_bcell(col, 1, p.src + (p.score > 0 ? "" : " (no edge yet)"), p.score > 0 ? (dir == 1 ? cBull : cBear) : cNeu, p.tip)
        f_bcell(col, 2, f_px(p.entry) + " " + p.how, cText)
        f_bcell(col, 3, f_px(p.stop) + " / " + f_px(p.target), cText)
        f_bcell(col, 4, (risk > 0 ? str.tostring(reward / risk, "0.0") + ":1" : "–") + " · " + dist, cText)
        f_bcell(col, 5, p.rec, cNeu)
    0

if barstate.islast and showBest
    array<Plan> longs = array.new<Plan>()
    array<Plan> shorts = array.new<Plan>()
    string ictRec  = nTrades == 0 ? "no trades yet" : str.tostring(100.0 * nWins / nTrades, "#") + "% won · " + f_signed(sumR / nTrades, "#.##") + "R · " + str.tostring(nTrades)
    float  ictEdge = f_edge(sumR, nTrades)
    string fibPct  = str.tostring(fibLevel * 100, "#.#") + "%"
    array<float> ofLevels = array.from(vwapV, poc, prevPoc)

    // ICT confluence: a reaction at the 79% level of the current leg.
    if pos == 1
        f_plan(longs, 1, "ICT confluence", entryPx, stopPx, tp2Px, "live", ictEdge, ictRec, "ICT long open since " + f_px(entryPx), true)
    else if trend == 1 and htfLong and legDir == 1 and fib79 < close
        f_plan(longs, 1, "ICT confluence", fib79, fib79 - atr, fib79 + tp2R * atr, "limit", ictEdge, ictRec, "Buy a bullish reaction at the " + fibPct + " level. The stop is an estimate.", false)
    if pos == -1
        f_plan(shorts, -1, "ICT confluence", entryPx, stopPx, tp2Px, "live", ictEdge, ictRec, "ICT short open since " + f_px(entryPx), true)
    else if trend == -1 and htfShort and legDir == -1 and fib79 > close
        f_plan(shorts, -1, "ICT confluence", fib79, fib79 + atr, fib79 - tp2R * atr, "limit", ictEdge, ictRec, "Sell a bearish reaction at the " + fibPct + " level. The stop is an estimate.", false)

    // Pullback: the fast EMA in a trend, targeting the last swing.
    bool pbLiveL = f_livePlan(longs, sPB, 1)
    if not pbLiveL and usePB and pbUp
        float e = math.min(close, pbFast)
        f_plan(longs, 1, "Pullback", e, e - atr, legDir == 1 ? legHigh : hi20, e < close ? "limit" : "now", f_edge(sPB.totR, sPB.n), f_rec(sPB), "Buy a reversal candle at the " + str.tostring(pbFastLen) + " EMA or the 38-62% zone", false)
    bool pbLiveS = f_livePlan(shorts, sPB, -1)
    if not pbLiveS and usePB and pbDn
        float e = math.max(close, pbFast)
        f_plan(shorts, -1, "Pullback", e, e + atr, legDir == -1 ? legLow : lo20, e > close ? "limit" : "now", f_edge(sPB.totR, sPB.n), f_rec(sPB), "Sell a reversal candle at the " + str.tostring(pbFastLen) + " EMA or the 38-62% zone", false)

    // Range: the edges of a confirmed range.
    bool rgLiveL = f_livePlan(longs, sRG, 1)
    if not rgLiveL and useRG and rgOk
        f_plan(longs, 1, "Range", rgLo + 0.1 * rgH, rgLo - stopAtr * atr, rgHi - 0.05 * rgH, "limit", f_edge(sRG.totR, sRG.n), f_rec(sRG), "Buy a reversal near the range low. First exit at the middle, " + f_px(rgMid), false)
    bool rgLiveS = f_livePlan(shorts, sRG, -1)
    if not rgLiveS and useRG and rgOk
        f_plan(shorts, -1, "Range", rgHi - 0.1 * rgH, rgHi + stopAtr * atr, rgLo + 0.05 * rgH, "limit", f_edge(sRG.totR, sRG.n), f_rec(sRG), "Sell a reversal near the range high. First exit at the middle, " + f_px(rgMid), false)

    // Mean reversion: the Bollinger bands, targeting the mean.
    bool mrLiveL = f_livePlan(longs, sMR, 1)
    if not mrLiveL and useMR
        f_plan(longs, 1, "Mean reversion", bbLo, bbLo - atr, mrMean, "on close", f_edge(sMR.totR, sMR.n), f_rec(sMR), "Buy when price pushes under the lower band with RSI under " + str.tostring(rsiLo) + " and closes back inside", false)
    bool mrLiveS = f_livePlan(shorts, sMR, -1)
    if not mrLiveS and useMR
        f_plan(shorts, -1, "Mean reversion", bbUp, bbUp + atr, mrMean, "on close", f_edge(sMR.totR, sMR.n), f_rec(sMR), "Sell when price pushes over the upper band with RSI over " + str.tostring(rsiHi) + " and closes back inside", false)

    // Breakout: a close outside a tight range.
    bool boLiveL = f_livePlan(longs, sBO, 1)
    if not boLiveL and useBO and boTightNow
        float e = boHiNow + mintickSafe
        float sl = math.max((boHiNow + boLoNow) / 2, e - atr)
        f_plan(longs, 1, "Breakout", e, sl, e + math.max(2 * (e - sl), boHiNow - boLoNow), "stop", f_edge(sBO.totR, sBO.n), f_rec(sBO), "Buy a close above the range on " + str.tostring(boVolMult, "0.0") + "x volume", false)
    bool boLiveS = f_livePlan(shorts, sBO, -1)
    if not boLiveS and useBO and boTightNow
        float e = boLoNow - mintickSafe
        float sl = math.min((boHiNow + boLoNow) / 2, e + atr)
        f_plan(shorts, -1, "Breakout", e, sl, e - math.max(2 * (sl - e), boHiNow - boLoNow), "stop", f_edge(sBO.totR, sBO.n), f_rec(sBO), "Sell a close below the range on " + str.tostring(boVolMult, "0.0") + "x volume", false)

    // Order flow: absorption, or VWAP / POC as the level to watch.
    bool ofLiveL = f_livePlan(longs, sOF, 1)
    if not ofLiveL and useOF
        if abDir == 1
            float sl = abLo - 0.1 * atr
            f_plan(longs, 1, "Order flow", abHi, sl, f_target(1, abHi, abHi - sl, vwapV, poc, prevPoc), "on close", f_edge(sOF.totR, sOF.n), f_rec(sOF), "Sellers were absorbed at " + f_px(abLo) + ". Buy a close above " + f_px(abHi), false)
        else
            float lv = na
            for x in ofLevels
                if not na(x) and x < close and (na(lv) or x > lv)
                    lv := x
            f_plan(longs, 1, "Order flow", lv, lv - atr, f_target(1, lv, atr, vwapV, poc, prevPoc), "limit", f_edge(sOF.totR, sOF.n), f_rec(sOF), "Watch for selling to be absorbed at VWAP or the POC", false)
    bool ofLiveS = f_livePlan(shorts, sOF, -1)
    if not ofLiveS and useOF
        if abDir == -1
            float sl = abHi + 0.1 * atr
            f_plan(shorts, -1, "Order flow", abLo, sl, f_target(-1, abLo, sl - abLo, vwapV, poc, prevPoc), "on close", f_edge(sOF.totR, sOF.n), f_rec(sOF), "Buyers were absorbed at " + f_px(abHi) + ". Sell a close below " + f_px(abLo), false)
        else
            float lv = na
            for x in ofLevels
                if not na(x) and x > close and (na(lv) or x < lv)
                    lv := x
            f_plan(shorts, -1, "Order flow", lv, lv + atr, f_target(-1, lv, atr, vwapV, poc, prevPoc), "limit", f_edge(sOF.totR, sOF.n), f_rec(sOF), "Watch for buying to be absorbed at VWAP or the POC", false)

    // News: the first pullback after a release move.
    bool nwLiveL = f_livePlan(longs, sNW, 1)
    if not nwLiveL and useNW and nwState == 2 and nwDir == 1
        float e = nwHi - 0.3 * (nwHi - nwLo)
        f_plan(longs, 1, "News", e, e - atr, e + nwTpR * atr, "limit", f_edge(sNW.totR, sNW.n), f_rec(sNW), "Buy the first pullback after the " + nwName + " move", false)
    bool nwLiveS = f_livePlan(shorts, sNW, -1)
    if not nwLiveS and useNW and nwState == 2 and nwDir == -1
        float e = nwLo + 0.3 * (nwHi - nwLo)
        f_plan(shorts, -1, "News", e, e + atr, e - nwTpR * atr, "limit", f_edge(sNW.totR, sNW.n), f_rec(sNW), "Sell the first pullback after the " + nwName + " move", false)

    // Scalping: a break of the last micro swing with the 9/21 EMAs.
    bool scLiveL = f_livePlan(longs, sSC, 1)
    if not scLiveL and useSC and scOk and ema9 > ema21 and not mHiUsed
        float r = math.max(scStopAtr * atr, mintickSafe * 2)
        float e = mHi + mintickSafe
        f_plan(longs, 1, "Scalping", e, e - r, e + scTpR * r, "stop", f_edge(sSC.totR, sSC.n), f_rec(sSC), "Buy a break of the micro high " + f_px(mHi), false)
    bool scLiveS = f_livePlan(shorts, sSC, -1)
    if not scLiveS and useSC and scOk and ema9 < ema21 and not mLoUsed
        float r = math.max(scStopAtr * atr, mintickSafe * 2)
        float e = mLo - mintickSafe
        f_plan(shorts, -1, "Scalping", e, e + r, e - scTpR * r, "stop", f_edge(sSC.totR, sSC.n), f_rec(sSC), "Sell a break of the micro low " + f_px(mLo), false)

    // GEX + order flow: the nearest GEX level on each side.
    bool gxLiveL = f_livePlan(longs, sGX, 1)
    if not gxLiveL and useGX and gexShowOn
        float sup = na
        for x in gxDLv
            if x < close and (na(sup) or x > sup)
                sup := x
        if not na(sup)
            float sl = sup - stopAtr * atr - 0.25 * atr
            f_plan(longs, 1, "GEX + order flow", sup, sl, f_nextLevel(gxDLv, 1, sup, sup - sl), "limit", f_edge(sGX.totR, sGX.n), f_rec(sGX), "Buy absorption or a delta reversal at the GEX level " + f_px(sup) + (gxRegime == "" ? "" : ". Now " + gxRegime), false)
    bool gxLiveS = f_livePlan(shorts, sGX, -1)
    if not gxLiveS and useGX and gexShowOn
        float res = na
        for x in gxDLv
            if x > close and (na(res) or x < res)
                res := x
        if not na(res)
            float sl = res + stopAtr * atr + 0.25 * atr
            f_plan(shorts, -1, "GEX + order flow", res, sl, f_nextLevel(gxDLv, -1, res, sl - res), "limit", f_edge(sGX.totR, sGX.n), f_rec(sGX), "Sell absorption or a delta reversal at the GEX level " + f_px(res) + (gxRegime == "" ? "" : ". Now " + gxRegime), false)

    // GEX + AVWAP: the open idea's trigger.
    bool gaLiveL = f_livePlan(longs, sGA, 1)
    bool gaLiveS = f_livePlan(shorts, sGA, -1)
    if useGA and gaPhase != 0 and not na(gaAvNow)
        int m = gaMove
        if gaPhase == 1 and not (m == -1 ? gaLiveL : gaLiveS)
            float sl = m == -1 ? gaExt - stopAtr * atr : gaExt + stopAtr * atr
            float rk = (gaAvNow - sl) * -m
            if rk > 0 and rk <= maxRiskAtr * atr
                f_plan(m == -1 ? longs : shorts, -m, "GEX + AVWAP", gaAvNow, sl, f_nextLevel(gxDLv, -m, gaAvNow, rk), "on close", f_edge(sGA.totR, sGA.n), f_rec(sGA), "Price came " + (m == -1 ? "down" : "up") + " into GEX " + f_px(gaLvl) + ". " + (m == -1 ? "Buy a close above" : "Sell a close below") + " the anchored VWAP: the move lost control. Wrong past " + f_px(gaExt), false)
        if gaPhase == 2 and not (m == -1 ? gaLiveS : gaLiveL)
            float sl = m == -1 ? gaLvl + gxTol + stopAtr * atr : gaLvl - gxTol - stopAtr * atr
            float rk = (gaLvl - sl) * m
            if rk > 0 and rk <= maxRiskAtr * atr
                f_plan(m == -1 ? shorts : longs, m, "GEX + AVWAP", gaLvl, sl, f_nextLevel(gxDLv, m, gaLvl, rk), "limit", f_edge(sGA.totR, sGA.n), f_rec(sGA), "Price broke GEX " + f_px(gaLvl) + " with the anchored VWAP holding. " + (m == -1 ? "Sell" : "Buy") + " a retest that holds. Off on a close back through the AVWAP, " + f_px(gaAvNow), false)

    Plan bestL = f_pick(longs)
    Plan bestS = f_pick(shorts)
    table.cell(bestTbl, 0, 0, "Best setups", text_color = cText, text_size = txtSize, text_halign = text.align_left, tooltip = "Each strategy proposes an entry, a stop and an exit. The pick has the best record on this chart among setups within 4 ATR of price. Estimates, not orders.")
    table.cell(bestTbl, 1, 0, "LONG", text_color = cBull, text_size = txtSize, text_halign = text.align_left)
    table.cell(bestTbl, 2, 0, "SHORT", text_color = cBear, text_size = txtSize, text_halign = text.align_left)
    f_bcell(0, 1, "Strategy", cKey)
    f_bcell(0, 2, "Entry", cKey)
    f_bcell(0, 3, "Stop / exit", cKey)
    f_bcell(0, 4, "Reward:risk · away", cKey)
    f_bcell(0, 5, "Record", cKey)
    f_bcol(1, bestL, 1)
    f_bcol(2, bestS, -1)
